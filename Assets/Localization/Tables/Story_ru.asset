  m_SharedData: {fileID: 11400000, guid: 55efdcf0114ad28428f7aa9433a157a5, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 212852736
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0443\u043B\u0438\u0446\u0443 \u0443 \u0434\u043E\u043C\u0430 \u042D\u043B\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 292544512
    m_Localized: "\u041F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u0441\u044C \u043A \u0432\u043E\u0440\u043E\u0442\u0430\u043C \u0438 \u043A\u0430\u043B\u0438\u0442\u043A\u0435 \u0434\u043E\u043C\u0430 \u042D\u043B\u0438\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 292544513
    m_Localized: "\u041D\u0430 \u0432\u043E\u0440\u043E\u0442\u0430\u0445 \u0432\u0438\u0441\u0438\u0442 \u0430\u0444\u0438\u0448\u0430, \u0430 \u043F\u043E\u0434 \u0444\u043E\u043D\u0430\u0440\u0451\u043C \u0443 \u043A\u0430\u043B\u0438\u0442\u043A\u0438 \u0447\u0442\u043E-\u0442\u043E \u043B\u0435\u0436\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 292544514
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0430\u0444\u0438\u0448\u0443 \u043D\u0430 \u0432\u043E\u0440\u043E\u0442\u0430\u0445 \u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u043A\u0443 \u043F\u043E\u0434 \u0444\u043E\u043D\u0430\u0440\u0451\u043C \u0443 \u043A\u0430\u043B\u0438\u0442\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 292544515
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043A\u0430\u0431\u0438\u043D\u0435\u0442 \u042D\u043B\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 292544516
    m_Localized: "\u0423\u0431\u0438\u0439\u0441\u0442\u0432\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E \u0432 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0435. \u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043F\u043E\u043B \u0438 \u043F\u043E\u043B\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 292544517
    m_Localized: "\u0423 \u0441\u0442\u043E\u043B\u0430 \u043B\u0435\u0436\u0430\u0442 \u0447\u0430\u0441\u044B \u0438 \u043E\u0431\u0440\u044B\u0432\u043E\u043A \u0431\u0443\u043C\u0430\u0433\u0438, \u043D\u0430 \u043F\u043E\u043B\u043A\u0435 \u0447\u0435\u0433\u043E-\u0442\u043E \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 292544518
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0447\u0430\u0441\u044B \u0443 \u043D\u043E\u0436\u043A\u0438 \u0441\u0442\u043E\u043B\u0430, \u043E\u0431\u0440\u044B\u0432\u043E\u043A \u043A\u0432\u0438\u0442\u0430\u043D\u0446\u0438\u0438 \u043D\u0430 \u043F\u043E\u043B\u0443 \u0438 \u043F\u043E\u043B\u043A\u0443 \u0441 \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u043D\u0438\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 292544519
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u0441 \u041C\u0430\u0440\u043E\u0439, \u041E\u0443\u044D\u043D\u043E\u043C \u0438 \u043C\u044D\u0440\u043E\u043C \u0432 \u0437\u0430\u043A\u0443\u0441\u043E\u0447\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 292544520
    m_Localized: "\u041F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u044B\u0435 \u0436\u0434\u0443\u0442 \u0432 \u0437\u0430\u043A\u0443\u0441\u043E\u0447\u043D\u043E\u0439 \xAB\u041D\u043E\u0447\u043D\u0430\u044F \u0441\u043E\u0432\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 296738816
    m_Localized: "\u0417\u0430\u043A\u0443\u0441\u043E\u0447\u043D\u0430\u044F \u2014 \u0441\u043F\u0440\u0430\u0432\u0430 \u043E\u0442 \u0434\u043E\u043C\u0430 \u042D\u043B\u0438\u0441, \u0443 \u043D\u0435\u0451 \u0433\u043E\u0440\u0438\u0442 \u0432\u044B\u0432\u0435\u0441\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 296738817
    m_Localized: "\u0417\u0430\u0439\u0434\u0438\u0442\u0435 \u0432 \u0437\u0430\u043A\u0443\u0441\u043E\u0447\u043D\u0443\u044E \u0438 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u0441 \u043A\u0430\u0436\u0434\u044B\u043C \u0438\u0437 \u0442\u0440\u043E\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 296738818
    m_Localized: "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u0441\u0435\u0439\u0444 \u042D\u043B\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 296738819
    m_Localized: "\u042D\u043B\u0438\u0441 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0443 \u043D\u0430\u0434 \u0441\u0435\u0439\u0444\u043E\u043C. \u041A\u0430\u043A\u043E\u0439 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A \u0443 \u043D\u0435\u0451 \u043B\u044E\u0431\u0438\u043C\u044B\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 296738820
    m_Localized: "\u041D\u043E\u0447\u044C \u043C\u0430\u0441\u043E\u043A \u2014 31 \u043E\u043A\u0442\u044F\u0431\u0440\u044F. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043C\u0435\u0441\u044F\u0446, \u043F\u043E\u0442\u043E\u043C \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 296738821
    m_Localized: "\u041A\u043E\u0434 \u0441\u0435\u0439\u0444\u0430 \u2014 1031."
    m_Metadata:
      m_Items: []
  - m_Id: 296738822
    m_Localized: "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u0444\u043E\u0442\u043E\u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0443 \u0420\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 296738823
    m_Localized: "\u041F\u043E\u0440\u044F\u0434\u043E\u043A \u0441\u043D\u0438\u043C\u043A\u043E\u0432 \u043E\u043F\u0438\u0441\u0430\u043D \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043A\u0435 \u0420\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 296738824
    m_Localized: "\u041F\u0440\u043E\u0433\u0443\u043B\u043A\u0430 \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C \u0443 \u0448\u043A\u043E\u043B\u044B \u0438 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C \u0434\u043E\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 296738825
    m_Localized: "\u041F\u043E\u0440\u044F\u0434\u043E\u043A \u0441\u043D\u0438\u043C\u043A\u043E\u0432: \u0448\u043A\u043E\u043B\u0430 \u2192 \u043C\u043E\u0441\u0442 \u2192 \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435 \u2192 \u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 296738826
    m_Localized: "\u0412\u044B\u044F\u0441\u043D\u0438\u0442\u0435, \u0447\u0442\u043E \u0438\u0441\u043A\u0430\u043B\u0438 \u0432 \u0441\u0442\u043E\u043B\u0435 \u042D\u043B\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 296738827
    m_Localized: "\u042F\u0449\u0438\u043A \u0441\u0442\u043E\u043B\u0430 \u043F\u0435\u0440\u0435\u043A\u043E\u0448\u0435\u043D \u2014 \u0437\u0430 \u043D\u0438\u043C \u043C\u043E\u0436\u0435\u0442 \u0447\u0442\u043E-\u0442\u043E \u0431\u044B\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 296738828
    m_Localized: "\u0417\u0430 \u044F\u0449\u0438\u043A\u043E\u043C \u043B\u0435\u0436\u0438\u0442 \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u0438\u043A. \u041D\u0430 \u043F\u0443\u0441\u0442\u043E\u043C \u043B\u0438\u0441\u0442\u0435 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0432\u043C\u044F\u0442\u0438\u043D\u044B \u2014 \u043D\u0443\u0436\u0435\u043D \u043C\u044F\u0433\u043A\u0438\u0439 \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 296738829
    m_Localized: "\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448 \u0441\u043E \u0441\u0442\u043E\u043B\u0430, \u0432\u044B\u043D\u044C\u0442\u0435 \u044F\u0449\u0438\u043A \u0438 \u0437\u0430\u0448\u0442\u0440\u0438\u0445\u0443\u0439\u0442\u0435 \u043B\u0438\u0441\u0442 \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 296738830
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u0430\u043B\u0438\u0431\u0438 \u043C\u044D\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 296738831
    m_Localized: "\u041C\u044D\u0440 \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u0431\u044B\u043B \u0432 \u0430\u043F\u0442\u0435\u043A\u0435 \u043D\u0430 \u041C\u0435\u0439\u043F\u043B-\u0441\u0442\u0440\u0438\u0442. \u0417\u0430\u043A\u0443\u0441\u043E\u0447\u043D\u0430\u044F \u2014 \u043D\u0430 \u0442\u043E\u0439 \u0436\u0435 \u0443\u043B\u0438\u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 296738832
    m_Localized: "\u0412 \u0437\u0430\u043A\u0443\u0441\u043E\u0447\u043D\u043E\u0439 \u0443 \u043A\u0430\u0441\u0441\u044B \u0432\u0438\u0441\u0438\u0442 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 296738833
    m_Localized: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u0443 \u043A\u0430\u0441\u0441\u044B \u0437\u0430\u043A\u0443\u0441\u043E\u0447\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 296738834
    m_Localized: "\u041D\u0430\u0437\u043E\u0432\u0438\u0442\u0435 \u0448\u0435\u0440\u0438\u0444\u0443 \u0438\u043C\u044F \u0443\u0431\u0438\u0439\u0446\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 296738835
    m_Localized: "\u0427\u044C\u0451 \u0430\u043B\u0438\u0431\u0438 \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 300933120
    m_Localized: "\u041C\u043E\u0442\u0438\u0432 \u2014 \u0432 \u0431\u0443\u043C\u0430\u0433\u0430\u0445 \u0438\u0437 \u0441\u0435\u0439\u0444\u0430, \u043B\u043E\u0436\u044C \u2014 \u0432 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F\u0445 \u043E \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u043C \u0432\u0435\u0447\u0435\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 300933121
    m_Localized: "\u042D\u0434\u0433\u0430\u0440 \u0420\u0438\u0434. \u041C\u043E\u0442\u0438\u0432 \u2014 \u0431\u0443\u043C\u0430\u0433\u0438 \u0442\u0440\u0451\u0445 \u0441\u0435\u043C\u0435\u0439, \u043B\u043E\u0436\u044C \u2014 \u0437\u0430\u043A\u0440\u044B\u0442\u0430\u044F \u0430\u043F\u0442\u0435\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 300933122
    m_Localized: "\u0414\u0435\u043B\u043E \u042D\u043B\u0438\u0441 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u043E. \u041D\u043E \u043A\u0442\u043E \u043F\u0440\u0438\u0441\u043B\u0430\u043B \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 300933123
    m_Localized: "\u042D\u0442\u0430 \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u0435\u0449\u0451 \u043D\u0435 \u0437\u0430\u043A\u043E\u043D\u0447\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 300933124
    m_Localized: "\u0420\u0443\u0442 \u043F\u0440\u043E\u043F\u0430\u043B\u0430 \u0432 \u041D\u043E\u0447\u044C \u043C\u0430\u0441\u043E\u043A \u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434. \u0418\u0445 \u0431\u044B\u043B\u043E \u0447\u0435\u0442\u0432\u0435\u0440\u043E \u2014 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u0442\u0440\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 300933125
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u0435 \u0441\u043B\u0435\u0434\u0443\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 481288192
    m_Localized: "\u0417\u0432\u043E\u043D\u043E\u043A \u0448\u0435\u0440\u0438\u0444\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 481288193
    m_Localized: "\u041C\u044D\u0440 \u0443\u0432\u0435\u0440\u044F\u0435\u0442, \u0447\u0442\u043E \u0432 21:05 \u043F\u043E\u043A\u0443\u043F\u0430\u043B \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E \u0443 \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0430, \u0430 \u043D\u0430 \u041C\u0435\u0439\u043F\u043B-\u0441\u0442\u0440\u0438\u0442 \u0432 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u043D\u0435 \u0431\u044B\u043B\u043E \u0441\u0432\u0435\u0442\u0430. \u0412\u044B \u043D\u0430\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u0448\u0435\u0440\u0438\u0444\u0430 \u041A\u043E\u0443\u043B.\n\n\xAB\u0410\u043F\u0442\u0435\u043A\u0430? \u0421\u0435\u0439\u0447\u0430\u0441 \u043F\u0440\u043E\u0432\u0435\u0440\u044E\xBB. \u0427\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0438\u043D\u0443\u0442 \u043E\u043D\u0430 \u043F\u0435\u0440\u0435\u0437\u0432\u0430\u043D\u0438\u0432\u0430\u0435\u0442: \xAB\u041D\u043E\u0440\u0430, \u0432\u0447\u0435\u0440\u0430 \u0432 20:47 \u0430\u043F\u0442\u0435\u043A\u0443 \u0437\u0430\u043A\u0440\u044B\u043B\u0438 \u0438\u0437-\u0437\u0430 \u0430\u0432\u0430\u0440\u0438\u0438 \u0438 \u043E\u0442\u043A\u0440\u044B\u043B\u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u0432 21:32. \u041A\u0430\u043C\u0435\u0440\u0430 \u0443 \u0432\u0445\u043E\u0434\u0430 \u044D\u0442\u043E \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442. \u041F\u0440\u0438\u0441\u044B\u043B\u0430\u044E \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 670031872
    m_Localized: "\u041A\u0430\u0440\u0442\u0438\u043D\u0430 \u0435\u0449\u0451 \u043D\u0435 \u0441\u043B\u043E\u0436\u0438\u043B\u0430\u0441\u044C. \u041D\u0443\u0436\u043D\u043E \u0437\u043D\u0430\u0442\u044C \u043C\u043E\u0442\u0438\u0432\u044B \u0432\u0441\u0435\u0445 \u0442\u0440\u043E\u0438\u0445, \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0430\u043B\u0438\u0431\u0438 \u0438 \u043D\u0430\u0439\u0442\u0438, \u0447\u0442\u043E \u042D\u043B\u0438\u0441 \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0430 \u0432 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 670031873
    m_Localized: "\u041C\u0430\u0440\u0430 \u0443\u0448\u043B\u0430 \u043E\u043A\u043E\u043B\u043E 20:56: \u043D\u0430 \u0437\u0430\u043F\u0438\u0441\u0438 \u043F\u043E\u0441\u043B\u0435 \u0435\u0451 \u043A\u0440\u0438\u043A\u0430 \u0445\u043B\u043E\u043F\u0430\u0435\u0442 \u0434\u0432\u0435\u0440\u044C, \u0430 \u0432 21:08 \u0441 \u042D\u043B\u0438\u0441 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0443\u0436\u0435 \u043C\u0443\u0436\u0447\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 670031874
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u042D\u0432\u0435\u043B\u0438\u043D \u043B\u0438\u0448\u0430\u0435\u0442 \u041E\u0443\u044D\u043D\u0430 \u043C\u043E\u0442\u0438\u0432\u0430, \u0430 \u043C\u0443\u0436\u0441\u043A\u043E\u0439 \u0433\u043E\u043B\u043E\u0441 \u043D\u0430 \u0437\u0430\u043F\u0438\u0441\u0438 \u2014 \u043D\u0435 \u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 670031875
    m_Localized: "\u042D\u0442\u043E\u0442 \u043C\u043E\u0442\u0438\u0432 \u043D\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442, \u0437\u0430\u0447\u0435\u043C \u043A\u043E\u043C\u0443-\u0442\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u044C \u043A \u042D\u043B\u0438\u0441 \u0432 21:08 \u0438 \u043E\u0431\u044B\u0441\u043A\u0438\u0432\u0430\u0442\u044C \u0441\u0442\u043E\u043B. \u0427\u0442\u043E \u042D\u043B\u0438\u0441 \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0430\u0441\u044C \u0443\u0442\u0440\u043E\u043C \u043E\u0442\u043D\u0435\u0441\u0442\u0438 \u043F\u0440\u043E\u043A\u0443\u0440\u043E\u0440\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 670031876
    m_Localized: "\u042D\u0442\u0430 \u0443\u043B\u0438\u043A\u0430 \u043D\u0435 \u043E\u043F\u0440\u043E\u0432\u0435\u0440\u0433\u0430\u0435\u0442 \u043D\u0438\u0447\u044C\u0438\u0445 \u0441\u043B\u043E\u0432. \u0427\u044C\u0451 \u0430\u043B\u0438\u0431\u0438 \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 670031877
    m_Localized: "\u041F\u044F\u0442\u044B\u0439 \u0441\u043D\u0438\u043C\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 670031878
    m_Localized: "\u0420\u0438\u0434 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043B, \u0447\u0442\u043E \u0432 21:05 \u043F\u043E\u043A\u0443\u043F\u0430\u043B \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E \u0443 \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0430. \u041D\u043E \u0430\u043F\u0442\u0435\u043A\u0430 \u0431\u044B\u043B\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u0430: \u0441\u0432\u0435\u0442 \u043F\u043E\u0433\u0430\u0441 \u0432 20:42, \u0438 \u043A\u0430\u043C\u0435\u0440\u0430 \u0443 \u0432\u0445\u043E\u0434\u0430 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043E\u043F\u0443\u0449\u0435\u043D\u043D\u0443\u044E \u0440\u0435\u0448\u0451\u0442\u043A\u0443. \u041B\u043E\u0436\u043D\u043E\u0435 \u0430\u043B\u0438\u0431\u0438 \u0441\u0430\u043C\u043E \u043F\u043E \u0441\u0435\u0431\u0435 \u043D\u0435 \u0434\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043E \u2014 \u043D\u043E \u0431\u0443\u043C\u0430\u0433\u0438 \u0438\u0437 \u0441\u0435\u0439\u0444\u0430 \u0434\u0430\u044E\u0442 \u043C\u043E\u0442\u0438\u0432, \u0430 \u0437\u0430\u043F\u0438\u0441\u044C \u0434\u0438\u043A\u0442\u043E\u0444\u043E\u043D\u0430 \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442 \u0420\u0438\u0434\u0430 \u0441 \u0443\u0434\u0430\u0440\u043E\u043C \u0432 21:10. \u0428\u0435\u0440\u0438\u0444 \u041A\u043E\u0443\u043B \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043C\u044D\u0440\u0430. \u0417\u0430\u043F\u0438\u0441\u044C, \u0447\u0430\u0441\u044B \u0438 \u043C\u0435\u0434\u043D\u0443\u044E \u0441\u0442\u0440\u0443\u0436\u043A\u0443 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0442 \u043D\u0430 \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u0438\u0437\u0443.\n\n\u041C\u0430\u0440\u0430 \u0441\u043A\u0440\u044B\u043B\u0430 \u0447\u0443\u0436\u043E\u0439 \u0437\u0430\u0434\u0430\u0442\u043E\u043A \u0438 \u0443\u0433\u0440\u043E\u0436\u0430\u043B\u0430 \u0441\u0435\u0441\u0442\u0440\u0435. \u041E\u0443\u044D\u043D \u043E\u0448\u0438\u0431\u0430\u043B\u0441\u044F \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u0441\u0432\u043E\u0435\u0433\u043E \u0434\u043E\u043C\u0430. \u0418\u0445 \u043F\u043E\u0441\u0442\u0443\u043F\u043A\u0438 \u043F\u043E\u043B\u0438\u0446\u0438\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E.\n\n\u0422\u0435\u043B\u0435\u0444\u043E\u043D \u0432\u0438\u0431\u0440\u0438\u0440\u0443\u0435\u0442. \u0421\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u0441 \u043D\u043E\u043C\u0435\u0440\u0430 \u042D\u043B\u0438\u0441: \xAB\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u041D\u043E\u0440\u0430\xBB. \u0418 \u0441\u043B\u0435\u0434\u043E\u043C \u0435\u0449\u0451 \u043E\u0434\u043D\u043E: \xAB\u0410 \u043C\u0435\u043D\u044F \u0442\u044B \u043D\u0430\u0439\u0434\u0451\u0448\u044C?\xBB\n\n\u0412 \u043E\u043A\u043D\u0435 \u043F\u0443\u0441\u0442\u043E\u0433\u043E \u0434\u043E\u043C\u0430 \u0437\u0430\u0433\u043E\u0440\u0430\u0435\u0442\u0441\u044F \u0441\u0432\u0435\u0442. \u041D\u0430 \u043F\u044F\u0442\u043E\u043C \u0441\u043D\u0438\u043C\u043A\u0435 \u0434\u0435\u0432\u043E\u0447\u043A\u0430 \u0441\u0442\u043E\u0438\u0442 \u0431\u043B\u0438\u0436\u0435, \u0447\u0435\u043C \u043F\u0440\u0435\u0436\u0434\u0435.\n\n\u041A\u041E\u041D\u0415\u0426 \u041F\u0415\u0420\u0412\u041E\u0413\u041E \u042D\u041F\u0418\u0417\u041E\u0414\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 850386944
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0425\u0435\u043B\u043B\u043E\u0443\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 850386945
    m_Localized: "\u0425\u043E\u043B\u043B\u043E\u0443-\u041A\u0440\u0438\u043A \u043F\u0440\u0430\u0437\u0434\u043D\u0443\u0435\u0442 \u041D\u043E\u0447\u044C \u043C\u0430\u0441\u043E\u043A. \u041D\u043E\u0440\u0430 \u0425\u0435\u0439\u043B, \u0431\u044B\u0432\u0448\u0438\u0439 \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C \u043F\u043E\u043B\u0438\u0446\u0438\u0438, \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0430 \u043D\u0430\u0432\u0435\u0441\u0442\u0438\u0442\u044C \u043F\u043E\u0434\u0440\u0443\u0433\u0443 \u2014 \u0436\u0443\u0440\u043D\u0430\u043B\u0438\u0441\u0442\u043A\u0443 \u042D\u043B\u0438\u0441 \u0423\u043E\u0440\u0434. \u041D\u043E \u042D\u043B\u0438\u0441 \u0443\u0431\u0438\u0442\u0430 \u043D\u0430\u043A\u0430\u043D\u0443\u043D\u0435 \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u0432 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C \u0434\u043E\u043C\u0435.\n\n\u041D\u043E\u0447\u044C\u044E \u0441 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430 \u042D\u043B\u0438\u0441 \u043F\u0440\u0438\u0448\u043B\u043E \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435: \xAB\u041D\u0430 \u0441\u043D\u0438\u043C\u043A\u0435 \u043D\u0430\u0441 \u0431\u044B\u043B\u043E \u0447\u0435\u0442\u0432\u0435\u0440\u043E. \u042F \u0432\u0441\u0451 \u0435\u0449\u0451 \u0437\u0434\u0435\u0441\u044C\xBB.\n\n\u0428\u0435\u0440\u0438\u0444 \u0425\u0430\u043D\u043D\u0430 \u041A\u043E\u0443\u043B \u2014 \u0434\u0430\u0432\u043D\u044F\u044F \u0437\u043D\u0430\u043A\u043E\u043C\u0430\u044F \u041D\u043E\u0440\u044B. \u0412\u0441\u0435 \u0435\u0451 \u043B\u044E\u0434\u0438 \u043D\u0430 \u0443\u043B\u0438\u0446\u0430\u0445, \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u044B \u043F\u0440\u0438\u0435\u0434\u0443\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0442\u0440\u043E\u043C, \u0434\u043E\u043C \u043E\u043F\u0435\u0447\u0430\u0442\u0430\u043D. \u0428\u0435\u0440\u0438\u0444 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u041D\u043E\u0440\u0435 \u043A\u043B\u044E\u0447 \u0438 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0430 \u043D\u0435\u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F. \u041F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u044B\u0435 \u0436\u0434\u0443\u0442 \u0432 \u0437\u0430\u043A\u0443\u0441\u043E\u0447\u043D\u043E\u0439 \xAB\u041D\u043E\u0447\u043D\u0430\u044F \u0441\u043E\u0432\u0430\xBB.\n\nWASD \u2014 \u0438\u0434\u0442\u0438, \u043C\u044B\u0448\u044C \u2014 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C, \u041B\u041A\u041C \u0438\u043B\u0438 E \u2014 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C. Tab \u2014 \u0434\u043D\u0435\u0432\u043D\u0438\u043A. Esc \u2014 \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
