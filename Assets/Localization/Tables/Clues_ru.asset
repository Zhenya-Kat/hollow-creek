  m_TableData:
  - m_Id: 456122368
    m_Localized: "\u0410\u0444\u0438\u0448\u0430 \u041D\u043E\u0447\u0438 \u043C\u0430\u0441\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 560979968
    m_Localized: "\u0423\u0438\u043B\u043B\u043E\u0443-\u0441\u0442\u0440\u0438\u0442 \xB7 \u0432\u043E\u0440\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 560979969
    m_Localized: "\xAB\u041D\u043E\u0447\u044C \u043C\u0430\u0441\u043E\u043A \u2014 31 \u043E\u043A\u0442\u044F\u0431\u0440\u044F! \u0428\u0435\u0441\u0442\u0432\u0438\u0435 \u0444\u043E\u043D\u0430\u0440\u0435\u0439 \u043E\u0442 \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u0434\u043E \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u043C\u043E\u0441\u0442\u0430\xBB. \u0410\u0444\u0438\u0448\u0430 \u043E\u0442\u0441\u044B\u0440\u0435\u043B\u0430, \u043D\u043E \u0434\u0430\u0442\u0443 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0447\u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 758112256
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u043A\u0430 \u0420\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 762306560
    m_Localized: "\u041F\u043E\u0434 \u0444\u043E\u043D\u0430\u0440\u0451\u043C \u0443 \u043A\u0430\u043B\u0438\u0442\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 762306561
    m_Localized: "\u0421\u0442\u0430\u0440\u0430\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u043A\u0430 \u0441 \u0432\u0438\u0434\u043E\u043C \u0425\u043E\u043B\u043B\u043E\u0443-\u041A\u0440\u0438\u043A. \u041D\u0430 \u043E\u0431\u043E\u0440\u043E\u0442\u0435 \u0434\u0435\u0442\u0441\u043A\u0438\u043C \u043F\u043E\u0447\u0435\u0440\u043A\u043E\u043C: \xAB\u041C\u044B \u0432\u044B\u0448\u043B\u0438 \u0438\u0437 \u0448\u043A\u043E\u043B\u044B, \u043F\u0435\u0440\u0435\u0448\u043B\u0438 \u0440\u0443\u0447\u0435\u0439 \u043F\u043E \u043C\u043E\u0441\u0442\u0443, \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0441\u0432\u0435\u0447\u0443 \u0443 \u043C\u043E\u0433\u0438\u043B\u044B \u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u0434\u043E\u043C\u043E\u0439. \u0417\u0430\u043F\u043E\u043C\u043D\u0438 \u043D\u0430\u0448 \u043F\u0443\u0442\u044C. \u0420\u0443\u0442\xBB. \u041D\u0430 \u043F\u043E\u043B\u044F\u0445 \u0440\u0443\u043A\u043E\u0439 \u042D\u043B\u0438\u0441: \xAB\u041A\u043B\u044E\u0447 \u043E\u0442 \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0438 \u2014 \u0432 \u0441\u0435\u0439\u0444\u0435\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 938467328
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430 \u0443 \u0441\u0435\u0439\u0444\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 938467329
    m_Localized: "\u041A\u0430\u0431\u0438\u043D\u0435\u0442 \u042D\u043B\u0438\u0441 \xB7 \u043D\u0430\u0434 \u0441\u0435\u0439\u0444\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 938467330
    m_Localized: "\u041B\u0438\u0441\u0442\u043E\u043A, \u043F\u0440\u0438\u043A\u043E\u043B\u043E\u0442\u044B\u0439 \u043D\u0430\u0434 \u0441\u0435\u0439\u0444\u043E\u043C \u0440\u0443\u043A\u043E\u0439 \u042D\u043B\u0438\u0441: \xAB\u041A\u043E\u0434 \u2014 \u043C\u043E\u0439 \u043B\u044E\u0431\u0438\u043C\u044B\u0439 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043C\u0435\u0441\u044F\u0446, \u043F\u043E\u0442\u043E\u043C \u0434\u0435\u043D\u044C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 1106239488
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u044B\u0435 \u0447\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1106239489
    m_Localized: "\u041A\u0430\u0431\u0438\u043D\u0435\u0442 \u042D\u043B\u0438\u0441 \xB7 \u0443 \u0441\u0442\u043E\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1106239490
    m_Localized: "\u041D\u0430\u0440\u0443\u0447\u043D\u044B\u0435 \u0447\u0430\u0441\u044B \u042D\u043B\u0438\u0441 \u043B\u0435\u0436\u0430\u0442 \u0443 \u043D\u043E\u0436\u043A\u0438 \u0441\u0442\u043E\u043B\u0430. \u0421\u0442\u0435\u043A\u043B\u043E \u0442\u0440\u0435\u0441\u043D\u0443\u043B\u043E, \u0441\u0442\u0440\u0435\u043B\u043A\u0438 \u0437\u0430\u043C\u0435\u0440\u043B\u0438 \u043D\u0430 21:10. \u0412 \u0440\u0435\u043C\u0435\u0448\u043A\u0435 \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0430 \u043C\u0435\u0434\u043D\u0430\u044F \u0441\u0442\u0440\u0443\u0436\u043A\u0430. \u0412 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0438 \u043C\u0435\u0434\u044D\u043A\u0441\u043F\u0435\u0440\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043F\u0440\u0438\u0441\u043B\u0430\u043B\u0430 \u0448\u0435\u0440\u0438\u0444: \u0441\u043C\u0435\u0440\u0442\u044C \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u043B\u0430 \u043C\u0435\u0436\u0434\u0443 21:00 \u0438 21:15."
    m_Metadata:
      m_Items: []
  - m_Id: 1282400256
    m_Localized: "\u041E\u0431\u0440\u044B\u0432\u043E\u043A \u043A\u0432\u0438\u0442\u0430\u043D\u0446\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1282400257
    m_Localized: "\u041A\u0430\u0431\u0438\u043D\u0435\u0442 \u042D\u043B\u0438\u0441 \xB7 \u043D\u0430 \u043F\u043E\u043B\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1282400258
    m_Localized: "\u041E\u0431\u0440\u044B\u0432\u043E\u043A \u0431\u043B\u0430\u043D\u043A\u0430: \xAB\u0417\u0430\u0434\u0430\u0442\u043E\u043A \u043F\u043E\u043B\u0443\u0447\u0435\u043D\xBB \u0438 \u0440\u0430\u0437\u043C\u0430\u0448\u0438\u0441\u0442\u0430\u044F \u043F\u043E\u0434\u043F\u0438\u0441\u044C \u2014 \u041C\u0430\u0440\u0430 \u0423\u043E\u0440\u0434. \u0421\u0443\u043C\u043C\u0430 \u043E\u0442\u043E\u0440\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1458561024
    m_Localized: "\u041F\u0443\u0441\u0442\u043E\u0435 \u043C\u0435\u0441\u0442\u043E \u043D\u0430 \u043F\u043E\u043B\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1458561025
    m_Localized: "\u041A\u0430\u0431\u0438\u043D\u0435\u0442 \u042D\u043B\u0438\u0441 \xB7 \u043A\u043D\u0438\u0436\u043D\u0430\u044F \u043F\u043E\u043B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1458561026
    m_Localized: "\u041D\u0430 \u043F\u043E\u043B\u043A\u0435 \u0441\u0442\u043E\u0438\u0442 \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u043C\u0435\u0434\u043D\u044B\u0439 \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u043D\u0438\u043A. \u0420\u044F\u0434\u043E\u043C \u0432 \u043F\u044B\u043B\u0438 \u2014 \u0447\u0438\u0441\u0442\u044B\u0439 \u043A\u0440\u0443\u0433 \u0442\u043E\u0433\u043E \u0436\u0435 \u0440\u0430\u0437\u043C\u0435\u0440\u0430: \u0432\u0442\u043E\u0440\u043E\u0439 \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u043D\u0438\u043A \u0438\u0437 \u043F\u0430\u0440\u044B \u043F\u0440\u043E\u043F\u0430\u043B, \u0438 \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435\u0434\u0430\u0432\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1634721792
    m_Localized: "\u0414\u0435\u043D\u044C\u0433\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1634721793
    m_Localized: "\u041C\u0430\u0440\u0430 \u0423\u043E\u0440\u0434 \xB7 \u0437\u0430\u0434\u0430\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1634721794
    m_Localized: "\u041C\u0430\u0440\u0430 \u0431\u0435\u0437 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u044F \u042D\u043B\u0438\u0441 \u0432\u0437\u044F\u043B\u0430 40 000 \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432 \u0437\u0430\u0434\u0430\u0442\u043A\u0430 \u0437\u0430 \u0441\u0435\u043C\u0435\u0439\u043D\u044B\u0439 \u0434\u043E\u043C \u0438 \u043F\u043E\u0433\u0430\u0441\u0438\u043B\u0430 \u0441\u0432\u043E\u0438 \u0434\u043E\u043B\u0433\u0438. \u042D\u043B\u0438\u0441 \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u044C \u0434\u043E\u043C \u0438 \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u0430 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438 \u0434\u043E \u0443\u0442\u0440\u0430, \u0438\u043D\u0430\u0447\u0435 \u043E\u0431\u0435\u0449\u0430\u043B\u0430 \u043F\u043E\u0439\u0442\u0438 \u0432 \u043F\u043E\u043B\u0438\u0446\u0438\u044E. \u041F\u043E\u0441\u043B\u0435 \u0441\u043C\u0435\u0440\u0442\u0438 \u0441\u0435\u0441\u0442\u0440\u044B \u041C\u0430\u0440\u0430 \u2014 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u0446\u0430. \u0415\u0451 \u0432\u0438\u0434\u0435\u043B\u0438 \u0443 \u0434\u043E\u043C\u0430 \u0432 20:50; \u043A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430 \u0443\u0448\u043B\u0430, \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0432\u0438\u0434\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 1806688256
    m_Localized: "\u0414\u043E\u043C, \u043E\u0431\u0435\u0449\u0430\u043D\u043D\u044B\u0439 \u0441\u0435\u043C\u044C\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1806688257
    m_Localized: "\u041E\u0443\u044D\u043D \u0411\u043B\u0435\u0439\u043A \xB7 \u043D\u0430\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1806688258
    m_Localized: "\u041E\u0443\u044D\u043D \u0432\u043B\u0430\u0434\u0435\u0435\u0442 \u0430\u043D\u0442\u0438\u043A\u0432\u0430\u0440\u043D\u043E\u0439 \u043B\u0430\u0432\u043A\u043E\u0439 \xAB\u0412\u0442\u043E\u0440\u0430\u044F \u0436\u0438\u0437\u043D\u044C\xBB. \u041E\u043D \u043F\u043E\u043A\u0430\u0437\u0430\u043B \u043A\u043E\u043F\u0438\u044E \u0437\u0430\u0432\u0435\u0449\u0430\u043D\u0438\u044F 1982 \u0433\u043E\u0434\u0430: \u0435\u0433\u043E \u0431\u0430\u0431\u0443\u0448\u043A\u0430, \u042D\u0432\u0435\u043B\u0438\u043D \u0411\u043B\u0435\u0439\u043A, \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0430 \u0434\u043E\u043C \u0435\u0433\u043E \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044F\u043C, \u0427\u0430\u0440\u043B\u044C\u0437\u0443 \u0438 \u0425\u0435\u043B\u0435\u043D. \u041E\u0443\u044D\u043D \u0443\u0432\u0435\u0440\u0435\u043D, \u0447\u0442\u043E \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043E \u0432\u044B\u043D\u0443\u0434\u0438\u043B\u043E \u0435\u0451 \u043F\u0440\u043E\u0434\u0430\u0442\u044C \u0434\u043E\u043C, \u0430 \u042D\u043B\u0438\u0441 \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430. \u041E\u043D \u0445\u043E\u0442\u0435\u043B \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0434\u043E\u043C \u0438 \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0442\u0438 \u0442\u0443\u0434\u0430 \u043B\u0430\u0432\u043A\u0443, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0432\u044B\u0441\u0435\u043B\u044F\u044E\u0442 \u0437\u0430 \u0434\u043E\u043B\u0433\u0438. \u041D\u0430\u043A\u0430\u043D\u0443\u043D\u0435 \u043E\u043D \u0443\u0433\u0440\u043E\u0436\u0430\u043B \u042D\u043B\u0438\u0441: \xAB\u0415\u0441\u043B\u0438 \u0442\u044B \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0448\u044C \u0431\u0443\u043C\u0430\u0433\u0438, \u044F \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044E \u0442\u0435\u0431\u044F \u043F\u043E\u0436\u0430\u043B\u0435\u0442\u044C\xBB. \u0421 20:40 \u0434\u043E 21:20 \u043E\u043D, \u043F\u043E \u0435\u0433\u043E \u0441\u043B\u043E\u0432\u0430\u043C, \u0431\u044B\u043B \u043E\u0434\u0438\u043D \u0432 \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0439 \u043B\u0430\u0432\u043A\u0435 \u2014 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C \u043D\u0435\u043A\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1978654720
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F \u043C\u044D\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1978654721
    m_Localized: "\u042D\u0434\u0433\u0430\u0440 \u0420\u0438\u0434 \xB7 \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0438\u0439 \u0432\u0435\u0447\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1978654722
    m_Localized: "\u0420\u0438\u0434 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442: \u0432 21:05 \u043E\u043D \u043F\u043E\u043A\u0443\u043F\u0430\u043B \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E \u0432 \u043A\u0440\u0443\u0433\u043B\u043E\u0441\u0443\u0442\u043E\u0447\u043D\u043E\u0439 \u0430\u043F\u0442\u0435\u043A\u0435 \u043D\u0430 \u041C\u0435\u0439\u043F\u043B-\u0441\u0442\u0440\u0438\u0442. \u0412\u0440\u0435\u043C\u044F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435, \u043A\u043E\u0433\u0434\u0430 \u0436\u0435\u043D\u0430 \u043F\u0440\u0438\u0441\u043B\u0430\u043B\u0430 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435. \u0417\u0430\u0448\u0451\u043B \u0432\u043D\u0443\u0442\u0440\u044C, \u043A\u0443\u043F\u0438\u043B \u0443 \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0430, \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0438\u043B\u0441\u044F \u043D\u0430\u043B\u0438\u0447\u043D\u044B\u043C\u0438, \u0447\u0435\u043A \u0432\u044B\u0431\u0440\u043E\u0441\u0438\u043B. \u041F\u043E\u0442\u043E\u043C \u043F\u043E\u0435\u0445\u0430\u043B \u0434\u043E\u043C\u043E\u0439. \u0412 \u0434\u043E\u043C \u042D\u043B\u0438\u0441, \u043F\u043E \u0435\u0433\u043E \u0441\u043B\u043E\u0432\u0430\u043C, \u043D\u0435 \u0437\u0430\u0445\u043E\u0434\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 2150621184
    m_Localized: "\u041E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u0443 \u043A\u0430\u0441\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2150621185
    m_Localized: "\u0417\u0430\u043A\u0443\u0441\u043E\u0447\u043D\u0430\u044F \xAB\u041D\u043E\u0447\u043D\u0430\u044F \u0441\u043E\u0432\u0430\xBB \xB7 \u041C\u0435\u0439\u043F\u043B-\u0441\u0442\u0440\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2150621186
    m_Localized: "\u041B\u0438\u0441\u0442\u043E\u043A, \u043F\u0440\u0438\u043A\u043B\u0435\u0435\u043D\u043D\u044B\u0439 \u0441\u043A\u043E\u0442\u0447\u0435\u043C \u043A \u043A\u0430\u0441\u0441\u0435: \xAB\u0414\u043E\u0440\u043E\u0433\u0438\u0435 \u0433\u043E\u0441\u0442\u0438! \u0412\u0447\u0435\u0440\u0430 \u0441 20:42 \u0434\u043E 21:32 \u043D\u0430 \u0432\u0441\u0435\u0439 \u041C\u0435\u0439\u043F\u043B-\u0441\u0442\u0440\u0438\u0442 \u043D\u0435 \u0431\u044B\u043B\u043E \u0441\u0432\u0435\u0442\u0430. \u041A\u0430\u0441\u0441\u0430 \u0438 \u043A\u043E\u0444\u0435\u043C\u0430\u0448\u0438\u043D\u0430 \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438 \u2014 \u043F\u0440\u043E\u0441\u0442\u0438\u0442\u0435 \u0437\u0430 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0435. \u0412\u0430\u0448\u0430 \u201E\u041D\u043E\u0447\u043D\u0430\u044F \u0441\u043E\u0432\u0430\u201C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 2314199040
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u0430\u044F \u0430\u043F\u0442\u0435\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2314199041
    m_Localized: "\u0428\u0435\u0440\u0438\u0444 \u041A\u043E\u0443\u043B \xB7 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0430\u043B\u0438\u0431\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2314199042
    m_Localized: "\u0428\u0435\u0440\u0438\u0444 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0430 \u0430\u043F\u0442\u0435\u043A\u0443 \u043D\u0430 \u041C\u0435\u0439\u043F\u043B-\u0441\u0442\u0440\u0438\u0442. 30 \u043E\u043A\u0442\u044F\u0431\u0440\u044F \u0441\u0432\u0435\u0442 \u043F\u0440\u043E\u043F\u0430\u043B \u0432 20:42; \u0432 20:47 \u0444\u0430\u0440\u043C\u0430\u0446\u0435\u0432\u0442 \u0432\u044B\u0432\u0435\u043B \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u0435\u0439, \u043E\u043F\u0443\u0441\u0442\u0438\u043B \u0440\u0435\u0448\u0451\u0442\u043A\u0443 \u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0442\u044C \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430. \u0410\u043F\u0442\u0435\u043A\u0430 \u043E\u0442\u043A\u0440\u044B\u043B\u0430\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0432 21:32. \u041A\u0430\u043C\u0435\u0440\u0430 \u0443 \u0432\u0445\u043E\u0434\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430 \u043E\u0442 \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u043E\u0433\u043E \u043F\u0438\u0442\u0430\u043D\u0438\u044F: \u0432\u0441\u0451 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0440\u0435\u0448\u0451\u0442\u043A\u0430 \u043E\u043F\u0443\u0449\u0435\u043D\u0430, \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0432\u0445\u043E\u0434\u0438\u043B. \u041D\u043E\u0447\u043D\u043E\u0433\u043E \u043E\u043A\u043D\u0430 \u0443 \u0430\u043F\u0442\u0435\u043A\u0438 \u043D\u0435\u0442. \u041A\u0443\u043F\u0438\u0442\u044C \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E \u0443 \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0430 \u0432 21:05 \u0431\u044B\u043B\u043E \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2486165504
    m_Localized: "\u0411\u0443\u043C\u0430\u0433\u0438 \u0442\u0440\u0451\u0445 \u0441\u0435\u043C\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2486165505
    m_Localized: "\u0421\u0435\u0439\u0444 \u042D\u043B\u0438\u0441 \xB7 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2486165506
    m_Localized: "\u0412 \u043E\u0434\u043D\u043E\u0439 \u043F\u0430\u043F\u043A\u0435 \u2014 \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0430 \u041C\u0430\u0440\u044B \u043D\u0430 40 000 \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432 \u0438 \u0447\u0435\u0440\u043D\u043E\u0432\u0438\u043A \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u044F \u042D\u043B\u0438\u0441 \u043E \u043C\u043E\u0448\u0435\u043D\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u0435 \u0441\u0435\u0441\u0442\u0440\u044B. \u0412 \u0434\u0440\u0443\u0433\u043E\u0439 \u2014 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u043C\u044D\u0440 \u0420\u0438\u0434 \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u043B \u0443\u0447\u0430\u0441\u0442\u043A\u0438 \u0443 \u0440\u0443\u0447\u044C\u044F \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u0434\u0441\u0442\u0430\u0432\u043D\u0443\u044E \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044E \u0441 \u043F\u043E\u0434\u0434\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u044F\u043C\u0438, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043F\u043E\u0434\u043F\u0438\u0441\u044C \u0441\u0430\u043C\u043E\u0439 \u042D\u043B\u0438\u0441. \u0423\u0442\u0440\u043E\u043C \u042D\u043B\u0438\u0441 \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0430\u0441\u044C \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u044D\u0442\u0438 \u0431\u0443\u043C\u0430\u0433\u0438 \u043F\u0440\u043E\u043A\u0443\u0440\u043E\u0440\u0443. \u0412 \u0442\u0440\u0435\u0442\u044C\u0435\u0439 \u2014 \u0432\u044B\u043F\u0438\u0441\u043A\u0430 \u0438\u0437 \u0440\u0435\u0435\u0441\u0442\u0440\u0430: \u0432 1987 \u0433\u043E\u0434\u0443 \u042D\u0432\u0435\u043B\u0438\u043D \u0411\u043B\u0435\u0439\u043A \u043F\u0440\u043E\u0434\u0430\u043B\u0430 \u0434\u043E\u043C \u0448\u0442\u0430\u0442\u0443, \u0430 \u0432 1998-\u043C \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438 \u0441\u0435\u0441\u0442\u0451\u0440 \u0423\u043E\u0440\u0434 \u043A\u0443\u043F\u0438\u043B\u0438 \u0435\u0433\u043E \u043D\u0430 \u0442\u043E\u0440\u0433\u0430\u0445. \u0421\u0432\u0435\u0440\u0445\u0443 \u043B\u0435\u0436\u0438\u0442 \u043B\u0430\u0442\u0443\u043D\u043D\u044B\u0439 \u043A\u043B\u044E\u0447 \u0438 \u0437\u0430\u043F\u0438\u0441\u043A\u0430 \u042D\u043B\u0438\u0441: \xAB\u041D\u0430\u0448\u043B\u0430 \u043D\u0430 \u0447\u0435\u0440\u0434\u0430\u043A\u0435 \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0443 \u0420\u0443\u0442. \u0412\u043D\u0443\u0442\u0440\u0438 \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043D\u0432\u0435\u0440\u0442 \u042D\u0432\u0435\u043B\u0438\u043D \u2014 \u043D\u0435 \u0432\u0441\u043A\u0440\u044B\u0432\u0430\u043B\u0430. \u041F\u043E\u043A\u0430\u0436\u0443 \u041E\u0443\u044D\u043D\u0443 \u043B\u0438\u0447\u043D\u043E\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 2649743360
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u042D\u0432\u0435\u043B\u0438\u043D \u0411\u043B\u0435\u0439\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2649743361
    m_Localized: "\u0424\u043E\u0442\u043E\u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0430 \u0420\u0443\u0442 \xB7 12 \u043D\u043E\u044F\u0431\u0440\u044F 1987 \u0433\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2649743362
    m_Localized: "\xAB\u0427\u0430\u0440\u043B\u044C\u0437 \u0438 \u0425\u0435\u043B\u0435\u043D, \u043F\u0440\u043E\u0441\u0442\u0438\u0442\u0435. \u042F \u0441\u0430\u043C\u0430 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B\u0430 \u0448\u0442\u0430\u0442\u0443 \u043A\u0443\u043F\u0438\u0442\u044C \u0434\u043E\u043C. \u041C\u0435\u043D\u044F \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u0440\u0438\u043D\u0443\u0436\u0434\u0430\u043B: \u043F\u043E\u0441\u043B\u0435 \u0441\u043C\u0435\u0440\u0442\u0438 \u0432\u0430\u0448\u0435\u0433\u043E \u043E\u0442\u0446\u0430 \u044F \u043D\u0435 \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u043B\u0430\u0441\u044C \u0441 \u043A\u0440\u0435\u0434\u0438\u0442\u0430\u043C\u0438. \u0414\u0435\u043D\u044C\u0433\u0438 \u043E\u0442 \u043F\u0440\u043E\u0434\u0430\u0436\u0438 \u0443\u0448\u043B\u0438 \u0431\u0430\u043D\u043A\u0443. \u0412 \u0437\u0430\u0432\u0435\u0449\u0430\u043D\u0438\u0438 1982 \u0433\u043E\u0434\u0430 \u044F \u043E\u0431\u0435\u0449\u0430\u043B\u0430 \u0432\u0430\u043C \u0434\u043E\u043C, \u043D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u043E\u043D \u043C\u043D\u0435 \u043D\u0435 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442. \u042F \u043D\u0435 \u0441\u043C\u043E\u0433\u043B\u0430 \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u044D\u0442\u043E \u0432\u0430\u043C \u0432 \u043B\u0438\u0446\u043E \u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E \u043F\u0438\u0441\u044C\u043C\u043E \u0432 \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0435 \u0420\u0443\u0442 \u2014 \u0427\u0430\u0440\u043B\u044C\u0437 \u0432\u0441\u0435\u0433\u0434\u0430 \u0443\u043C\u0435\u043B \u0435\u0451 \u043E\u0442\u043A\u0440\u044B\u0442\u044C. \u041C\u0430\u043C\u0430\xBB. \u0412 \u043A\u043E\u043D\u0432\u0435\u0440\u0442\u0435 \u2014 \u043A\u043E\u043F\u0438\u044F \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0430 \u0441\u043E \u0448\u0442\u0430\u0442\u043E\u043C \u0438 \u0431\u0430\u043D\u043A\u043E\u0432\u0441\u043A\u0430\u044F \u043A\u0432\u0438\u0442\u0430\u043D\u0446\u0438\u044F \u043E \u043F\u043E\u0433\u0430\u0448\u0435\u043D\u0438\u0438 \u0434\u043E\u043B\u0433\u043E\u0432. \u042D\u0442\u043E \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442 \u0438\u0441\u0442\u043E\u0440\u0438\u044E \u0441\u0435\u043C\u044C\u0438 \u0411\u043B\u0435\u0439\u043A, \u043D\u043E \u043D\u0435 \u0434\u0430\u0451\u0442 \u041E\u0443\u044D\u043D\u0443 \u0430\u043B\u0438\u0431\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2817515520
    m_Localized: "\u041F\u0440\u043E\u044F\u0432\u043B\u0435\u043D\u043D\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u044C \u042D\u043B\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2817515521
    m_Localized: "\u0415\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u0438\u043A \xB7 \u0432\u043C\u044F\u0442\u0438\u043D\u044B \u043D\u0430 \u043B\u0438\u0441\u0442\u0435"
