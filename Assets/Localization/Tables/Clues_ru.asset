      m_Items: []
  - m_Id: 2817515522
    m_Localized: "\u041F\u043E\u0434 \u0448\u0442\u0440\u0438\u0445\u043E\u0432\u043A\u043E\u0439 \u043C\u044F\u0433\u043A\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448\u0430 \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u0438\u043B\u0438 \u0432\u0434\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435 \u0441\u0442\u0440\u043E\u043A\u0438: \xAB30 \u043E\u043A\u0442\u044F\u0431\u0440\u044F, 20:30. \u0414\u0438\u043A\u0442\u043E\u0444\u043E\u043D \u2014 \u043F\u043E\u0434 \u0437\u0430\u0434\u043D\u0438\u043C \u043A\u0440\u0430\u0435\u043C \u0441\u0442\u043E\u043B\u0435\u0448\u043D\u0438\u0446\u044B, \u0437\u0430 \u043A\u0430\u0431\u0435\u043B\u044C\u043D\u043E\u0439 \u043F\u043B\u0430\u043D\u043A\u043E\u0439. \u041C\u0438\u043A\u0440\u043E\u0444\u043E\u043D \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0443 \u0449\u0435\u043B\u0438. \u041D\u043E\u0432\u0430\u044F \u0431\u0430\u0442\u0430\u0440\u0435\u044F. \u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0434\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0430 \u0433\u043E\u0441\u0442\u0435\u0439\xBB. \u041B\u0438\u0441\u0442 \u0441 \u044D\u0442\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u044C\u044E \u042D\u043B\u0438\u0441 \u0432\u044B\u0440\u0432\u0430\u043B\u0430 \u0441\u0430\u043C\u0430 \u2014 \u0432 \u043F\u0435\u043F\u0435\u043B\u044C\u043D\u0438\u0446\u0435 \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043F\u0435\u043F\u0435\u043B. \u041D\u043E \u0440\u0443\u0447\u043A\u0430 \u043F\u0440\u043E\u0434\u0430\u0432\u0438\u043B\u0430 \u0431\u0443\u043C\u0430\u0433\u0443 \u043D\u0430\u0441\u043A\u0432\u043E\u0437\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2985287680
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0437\u0430\u043F\u0438\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2985287681
    m_Localized: "\u0414\u0438\u043A\u0442\u043E\u0444\u043E\u043D \u043F\u043E\u0434 \u0441\u0442\u043E\u043B\u0435\u0448\u043D\u0438\u0446\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2985287682
    m_Localized: "\u0411\u0430\u0442\u0430\u0440\u0435\u044F \u0434\u0438\u043A\u0442\u043E\u0444\u043E\u043D\u0430 \u0441\u0435\u043B\u0430, \u043D\u043E \u0444\u0430\u0439\u043B \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0441\u044F. \u0412 20:31 \u042D\u043B\u0438\u0441 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442 \u043C\u0438\u043A\u0440\u043E\u0444\u043E\u043D: \xAB\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u043E\u0435 \u043E\u043A\u0442\u044F\u0431\u0440\u044F. \u041E\u0441\u0442\u0430\u0432\u043B\u044F\u044E \u0437\u0430\u043F\u0438\u0441\u044C \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\xBB. \u0412 20:53 \u041C\u0430\u0440\u0430 \u043A\u0440\u0438\u0447\u0438\u0442: \xAB\u0415\u0441\u043B\u0438 \u0442\u044B \u043F\u043E\u0434\u0430\u0448\u044C \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u0435, \u043C\u043D\u0435 \u043A\u043E\u043D\u0435\u0446! \u0422\u044B \u0445\u043E\u0447\u0435\u0448\u044C \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u0443 \u043C\u0435\u043D\u044F \u0432\u0441\u0451?\xBB \u0425\u043B\u043E\u043F\u0430\u0435\u0442 \u0434\u0432\u0435\u0440\u044C. \u0412 21:08 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0434\u0440\u0443\u0433\u043E\u0439 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440. \u042D\u043B\u0438\u0441: \xAB\u0412\u0430\u0448\u0430 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F, \u0432\u0430\u0448\u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u0438. \u0417\u0430\u0432\u0442\u0440\u0430 \u044D\u0442\u043E \u0443\u0432\u0438\u0434\u0438\u0442 \u043F\u0440\u043E\u043A\u0443\u0440\u043E\u0440. \u041F\u043E\u043B\u043E\u0436\u0438\u0442\u0435 \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u043D\u0438\u043A\xBB. \u041C\u0443\u0436\u0441\u043A\u043E\u0439 \u0433\u043E\u043B\u043E\u0441: \xAB\u0413\u043E\u0440\u043E\u0434 \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u0442 \u044D\u0442\u0443 \u0441\u0434\u0435\u043B\u043A\u0443 \u0438\u0437-\u0437\u0430 \u0442\u0435\u0431\u044F\xBB. \u0412 21:10 \u2014 \u0443\u0434\u0430\u0440. \u041F\u043E\u0442\u043E\u043C \u0448\u043E\u0440\u043E\u0445 \u0431\u0443\u043C\u0430\u0433, \u0441\u043A\u0440\u0435\u0436\u0435\u0442 \u044F\u0449\u0438\u043A\u043E\u0432 \u2014 \u043A\u0442\u043E-\u0442\u043E \u043E\u0431\u044B\u0441\u043A\u0438\u0432\u0430\u0435\u0442 \u0441\u0442\u043E\u043B. \u0427\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0438\u043D\u0443\u0442 \u0445\u043B\u043E\u043F\u0430\u0435\u0442 \u0432\u0445\u043E\u0434\u043D\u0430\u044F \u0434\u0432\u0435\u0440\u044C. \u0427\u0435\u0439 \u044D\u0442\u043E \u043C\u0443\u0436\u0441\u043A\u043E\u0439 \u0433\u043E\u043B\u043E\u0441, \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442 \u043F\u043E\u043D\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 3148865536
    m_Localized: "\u0413\u043E\u043B\u043E\u0441 \u043D\u0430 \u0437\u0430\u043F\u0438\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 3148865537
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0437\u0430\u043F\u0438\u0441\u044C \xB7 21:08"
    m_Metadata:
      m_Items: []
  - m_Id: 3148865538
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u0439 \u043D\u0435\u0442: \u043C\u0443\u0436\u0441\u043A\u043E\u0439 \u0433\u043E\u043B\u043E\u0441 \u043D\u0430 \u0437\u0430\u043F\u0438\u0441\u0438 \u2014 \u0433\u043E\u043B\u043E\u0441 \u043C\u044D\u0440\u0430 \u042D\u0434\u0433\u0430\u0440\u0430 \u0420\u0438\u0434\u0430. \u0422\u0430 \u0436\u0435 \u043D\u0435\u0442\u043E\u0440\u043E\u043F\u043B\u0438\u0432\u0430\u044F \u043C\u0430\u043D\u0435\u0440\u0430, \u0442\u0435 \u0436\u0435 \u0441\u043B\u043E\u0432\u0430 \u043F\u0440\u043E \xAB\u0433\u043E\u0440\u043E\u0434\xBB. \u041F\u043E\u0434\u043B\u0438\u043D\u043D\u043E\u0441\u0442\u044C \u0437\u0430\u043F\u0438\u0441\u0438 \u0438 \u0433\u043E\u043B\u043E\u0441\u0430 \u0434\u043E\u043B\u0436\u043D\u0430 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u0438\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 3316637696
    m_Localized: "\u041C\u0430\u0448\u0438\u043D\u0430 \u0443 \u0432\u043E\u0440\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 3316637697
    m_Localized: "\u041C\u0430\u0440\u0430 \u0423\u043E\u0440\u0434 \xB7 \u043E\u043A\u043E\u043B\u043E 20:56"
    m_Metadata:
      m_Items: []
  - m_Id: 3316637698
    m_Localized: "\u0423\u0445\u043E\u0434\u044F \u043E\u0442 \u042D\u043B\u0438\u0441 \u043E\u043A\u043E\u043B\u043E 20:56, \u041C\u0430\u0440\u0430 \u0432\u0438\u0434\u0435\u043B\u0430 \u0443 \u0432\u043E\u0440\u043E\u0442 \u0442\u0451\u043C\u043D\u044B\u0439 \u0441\u0435\u0434\u0430\u043D \u0441 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u043C\u0438 \u043D\u043E\u043C\u0435\u0440\u0430\u043C\u0438. \u041C\u043E\u0442\u043E\u0440 \u0437\u0430\u0433\u043B\u0443\u0448\u0435\u043D, \u0444\u0430\u0440\u044B \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D\u044B. \u0422\u0430\u043A\u0438\u0435 \u043D\u043E\u043C\u0435\u0440\u0430 \u0431\u044B\u0432\u0430\u044E\u0442 \u0443 \u043C\u0430\u0448\u0438\u043D \u043C\u044D\u0440\u0438\u0438."
