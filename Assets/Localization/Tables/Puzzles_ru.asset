  m_TableData:
  - m_Id: 443539456
    m_Localized: "\u0421\u0435\u0439\u0444 \u042D\u043B\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 514842624
    m_Localized: "\u041A\u043E\u0434\u043E\u0432\u044B\u0439 \u0437\u0430\u043C\u043E\u043A \u043D\u0430 \u0447\u0435\u0442\u044B\u0440\u0435 \u0446\u0438\u0444\u0440\u044B. \u041D\u0430\u0434 \u0434\u0432\u0435\u0440\u0446\u0435\u0439 \u043F\u0440\u0438\u043A\u043E\u043B\u043E\u0442\u0430 \u0437\u0430\u043F\u0438\u0441\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 514842625
    m_Localized: "\u0414\u0432\u0435\u0440\u0446\u0430 \u0441\u0435\u0439\u0444\u0430 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F. \u0412\u043D\u0443\u0442\u0440\u0438 \u2014 \u0442\u0440\u0438 \u043F\u0430\u043F\u043A\u0438 \u0441 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438 \u0438 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043B\u0430\u0442\u0443\u043D\u043D\u044B\u0439 \u043A\u043B\u044E\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 514842626
    m_Localized: "\u0421\u0435\u0439\u0444 \u043F\u0443\u0441\u0442: \u0432\u0441\u0451, \u0447\u0442\u043E \u0432 \u043D\u0451\u043C \u0431\u044B\u043B\u043E, \u0442\u0435\u043F\u0435\u0440\u044C \u0443 \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 829415424
    m_Localized: "\u0424\u043E\u0442\u043E\u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0430 \u0420\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 829415425
    m_Localized: "\u041B\u0430\u0442\u0443\u043D\u043D\u044B\u0439 \u043A\u043B\u044E\u0447 \u043E\u0442\u043A\u0440\u044B\u043B \u043A\u0440\u044B\u0448\u043A\u0443. \u041F\u043E\u0434 \u043D\u0435\u0439 \u2014 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u0441 \u0447\u0435\u0442\u044B\u0440\u044C\u043C\u044F \u043F\u043E\u043B\u0430\u0440\u043E\u0438\u0434\u0430\u043C\u0438. \u0420\u0430\u0441\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0441\u043D\u0438\u043C\u043A\u0438 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435 \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 829415426
    m_Localized: "\u041A\u0440\u044B\u0448\u043A\u0430 \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0438 \u0437\u0430\u043F\u0435\u0440\u0442\u0430 \u043D\u0430 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043B\u0430\u0442\u0443\u043D\u043D\u044B\u0439 \u0437\u0430\u043C\u043E\u043A. \u041D\u0443\u0436\u0435\u043D \u043A\u043B\u044E\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 829415427
    m_Localized: "\u041C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u0449\u0451\u043B\u043A\u0430\u0435\u0442, \u0438 \u0434\u043D\u043E \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F. \u041F\u043E\u0434 \u043D\u0438\u043C \u2014 \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043D\u0432\u0435\u0440\u0442.\n\n\u0410 \u043F\u043E\u0434 \u043A\u043E\u043D\u0432\u0435\u0440\u0442\u043E\u043C \u2014 \u043F\u044F\u0442\u044B\u0439 \u0441\u043D\u0438\u043C\u043E\u043A. \u041D\u0430 \u043D\u0451\u043C \u0432\u044B \u0441\u0442\u043E\u0438\u0442\u0435 \u0443 \u044D\u0442\u043E\u0439 \u0441\u0430\u043C\u043E\u0439 \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0438. \u0417\u0430 \u0432\u0430\u0448\u0438\u043C \u043F\u043B\u0435\u0447\u043E\u043C \u2014 \u0434\u0435\u0432\u043E\u0447\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 829415428
    m_Localized: "\u0428\u043A\u0430\u0442\u0443\u043B\u043A\u0430 \u043F\u0443\u0441\u0442\u0430. \u041F\u044F\u0442\u044B\u0439 \u0441\u043D\u0438\u043C\u043E\u043A \u0432\u044B \u043D\u0435 \u0440\u0435\u0448\u0430\u0435\u0442\u0435\u0441\u044C \u0432\u0437\u044F\u0442\u044C \u0432 \u0440\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 837804032
    m_Localized: "\u0428\u043A\u043E\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 837804033
    m_Localized: "\u041C\u043E\u0441\u0442 \u0447\u0435\u0440\u0435\u0437 \u0440\u0443\u0447\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 837804034
    m_Localized: "\u041A\u043B\u0430\u0434\u0431\u0438\u0449\u0435, \u0441\u0432\u0435\u0447\u0430 \u0443 \u043C\u043E\u0433\u0438\u043B\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 837804035
    m_Localized: "\u0414\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 841998336
    m_Localized: "\u041C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u043D\u0435 \u043F\u043E\u0434\u0434\u0430\u0451\u0442\u0441\u044F. \u0421\u043D\u0438\u043C\u043A\u0438 \u043B\u0435\u0436\u0430\u0442 \u043D\u0435 \u0432 \u0442\u043E\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1013964800
    m_Localized: "\u0415\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u0438\u043A \u042D\u043B\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 1013964801
    m_Localized: "\u041B\u0438\u0441\u0442 \u0437\u0430 30 \u043E\u043A\u0442\u044F\u0431\u0440\u044F \u0432\u044B\u0440\u0432\u0430\u043D. \u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0432\u043C\u044F\u0442\u0438\u043D\u044B \u043E\u0442 \u0440\u0443\u0447\u043A\u0438 \u2014 \u0438\u0445 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u044F\u0432\u0438\u0442\u044C, \u0437\u0430\u0448\u0442\u0440\u0438\u0445\u043E\u0432\u0430\u0432 \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1013964802
    m_Localized: "\u041D\u0430 \u043F\u0443\u0441\u0442\u043E\u043C \u043B\u0438\u0441\u0442\u0435 \u0432\u0438\u0434\u043D\u044B \u0432\u043C\u044F\u0442\u0438\u043D\u044B \u043E\u0442 \u0440\u0443\u0447\u043A\u0438. \u0427\u0442\u043E\u0431\u044B \u0438\u0445 \u043F\u0440\u043E\u044F\u0432\u0438\u0442\u044C, \u043D\u0443\u0436\u0435\u043D \u043C\u044F\u0433\u043A\u0438\u0439 \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 1013964803
    m_Localized: "\u0421\u0442\u0440\u043E\u043A\u0438 \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u0438\u043B\u0438. \u042D\u043B\u0438\u0441 \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0430 \u0434\u0438\u043A\u0442\u043E\u0444\u043E\u043D \u043F\u043E\u0434 \u0441\u0442\u043E\u043B\u0435\u0448\u043D\u0438\u0446\u0435\u0439 \u2014 \u0437\u0430 \u043A\u0430\u0431\u0435\u043B\u044C\u043D\u043E\u0439 \u043F\u043B\u0430\u043D\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1013964804
    m_Localized: "\u0421\u0442\u0440\u043E\u043A\u0438 \u043D\u0430 \u043B\u0438\u0441\u0442\u0435 \u0443\u0436\u0435 \u043F\u0440\u043E\u044F\u0432\u043B\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1013964805
    m_Localized: "30 \u043E\u043A\u0442\u044F\u0431\u0440\u044F, 20:30. \u0414\u0438\u043A\u0442\u043E\u0444\u043E\u043D \u2014 \u043F\u043E\u0434 \u0437\u0430\u0434\u043D\u0438\u043C \u043A\u0440\u0430\u0435\u043C \u0441\u0442\u043E\u043B\u0435\u0448\u043D\u0438\u0446\u044B,"
    m_Metadata:
      m_Items: []
  - m_Id: 1013964806
    m_Localized: "\u0437\u0430 \u043A\u0430\u0431\u0435\u043B\u044C\u043D\u043E\u0439 \u043F\u043B\u0430\u043D\u043A\u043E\u0439. \u041C\u0438\u043A\u0440\u043E\u0444\u043E\u043D \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0443 \u0449\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1013964807
    m_Localized: "\u041D\u043E\u0432\u0430\u044F \u0431\u0430\u0442\u0430\u0440\u0435\u044F. \u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0434\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0430 \u0433\u043E\u0441\u0442\u0435\u0439."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
