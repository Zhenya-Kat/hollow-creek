  m_Name: Dialogue_ru
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ru
  m_SharedData: {fileID: 11400000, guid: 4841907fde87b9c49b2deb249a14e36c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 200269824
    m_Localized: "\u041C\u0430\u0440\u0430 \u0423\u043E\u0440\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 279961600
    m_Localized: "\u0421\u0435\u0441\u0442\u0440\u0430 \u042D\u043B\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 279961601
    m_Localized: "\xAB\u0412\u044B \u041D\u043E\u0440\u0430? \u042D\u043B\u0438\u0441 \u043E \u0432\u0430\u0441 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0430\xBB. \u041C\u0430\u0440\u0430 \u0441\u0436\u0438\u043C\u0430\u0435\u0442 \u0432 \u043A\u0443\u043B\u0430\u043A\u0435 \u043A\u043B\u044E\u0447 \u043E\u0442 \u0434\u043E\u043C\u0430 \u2014 \u0442\u0435\u043F\u0435\u0440\u044C \u0435\u0451 \u0434\u043E\u043C\u0430 \u2014 \u0442\u0430\u043A \u0441\u0438\u043B\u044C\u043D\u043E, \u0447\u0442\u043E \u0431\u0435\u043B\u0435\u044E\u0442 \u043A\u043E\u0441\u0442\u044F\u0448\u043A\u0438. \xAB\u0412 \u0441\u0435\u0439\u0444\u0435 \u0443 \u043D\u0435\u0451 \u0431\u0443\u043C\u0430\u0433\u0438 \u043E\u0431\u043E \u043C\u043D\u0435. \u041D\u0435 \u0432\u0441\u0451, \u0447\u0442\u043E \u0442\u0430\u043C \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E, \u043F\u0440\u0430\u0432\u0434\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 279961602
    m_Localized: "\u041C\u0430\u0440\u0430 \u043A\u0430\u0447\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u043E\u0439: \xAB\u041D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u043F\u0440\u0438 \u0447\u0451\u043C \u0437\u0434\u0435\u0441\u044C \u044D\u0442\u043E\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 284155904
    m_Localized: "\u0418\u0437-\u0437\u0430 \u0447\u0435\u0433\u043E \u0431\u044B\u043B\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0441\u0441\u043E\u0440\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 284155905
    m_Localized: "\xAB\u0421\u043E\u0440\u043E\u043A \u0442\u044B\u0441\u044F\u0447. \u042F \u0432\u0437\u044F\u043B\u0430 \u0437\u0430\u0434\u0430\u0442\u043E\u043A, \u0434\u0443\u043C\u0430\u043B\u0430, \u0443\u0433\u043E\u0432\u043E\u0440\u044E \u0435\u0451 \u043F\u0440\u043E\u0434\u0430\u0442\u044C \u0434\u043E\u043C. \u0414\u0435\u043D\u044C\u0433\u0438 \u0443\u0448\u043B\u0438 \u043A\u0440\u0435\u0434\u0438\u0442\u043E\u0440\u0430\u043C. \u042D\u043B\u0438\u0441 \u0434\u0430\u043B\u0430 \u043C\u043D\u0435 \u0441\u0440\u043E\u043A \u0434\u043E \u0443\u0442\u0440\u0430 \u2014 \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u043B\u0438\u0446\u0438\u044F. \u0412\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442\u0435, \u0447\u0442\u043E \u043C\u043D\u0435 \u0433\u0440\u043E\u0437\u0438\u043B\u043E? \u041D\u043E \u044F \u0435\u0451 \u043D\u0435 \u0443\u0431\u0438\u0432\u0430\u043B\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 288350208
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0432\u044B \u0443\u0448\u043B\u0438 \u043E\u0442 \u042D\u043B\u0438\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 288350209
    m_Localized: "\xAB\u041E\u043A\u043E\u043B\u043E \u0434\u0435\u0432\u044F\u0442\u0438. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0447\u0443\u0442\u044C \u0440\u0430\u043D\u044C\u0448\u0435. \u041F\u043E\u0448\u043B\u0430 \u043A \u0440\u0443\u0447\u044C\u044E, \u0447\u0442\u043E\u0431\u044B \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u044C\u0441\u044F. \u041E\u0434\u043D\u0430\xBB. \u0412\u044B \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442\u0435 \u0440\u0430\u0437\u0440\u044B\u0432 \u043D\u0430 \u0440\u0443\u043A\u0430\u0432\u0435. \xAB\u0417\u0430\u0446\u0435\u043F\u0438\u043B\u0430\u0441\u044C \u0437\u0430 \u043A\u0430\u043B\u0438\u0442\u043A\u0443. \u0414\u0430, \u044F \u043D\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430 \u0435\u0439 \u0443\u0436\u0430\u0441\u043D\u043E\u0433\u043E. \u0418 \u0434\u0430, \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u043E\u043C \u043C\u043E\u0439. \u042D\u0442\u043E \u043D\u0435 \u0437\u043D\u0430\u0447\u0438\u0442, \u0447\u0442\u043E \u044F \u0445\u043E\u0442\u0435\u043B\u0430 \u0435\u0451 \u0441\u043C\u0435\u0440\u0442\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 288350210
    m_Localized: "\u041A\u0430\u043A\u043E\u0439 \u0431\u044B\u043B\u0430 \u042D\u043B\u0438\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 288350211
    m_Localized: "\xAB\u0423\u043F\u0440\u044F\u043C\u043E\u0439. \u0415\u0441\u043B\u0438 \u0431\u0440\u0430\u043B\u0430\u0441\u044C \u0437\u0430 \u0438\u0441\u0442\u043E\u0440\u0438\u044E \u2014 \u043D\u0435 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u043B\u0430. \u041E\u043D\u0430 \u0438 \u043C\u0435\u043D\u044F \u0431\u044B \u043D\u0435 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B\u0430, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0431\u044B \u044F \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u044F\u0445 \u043F\u0440\u043E\u0441\u0438\u043B\u0430\xBB. \u041C\u0430\u0440\u0430 \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043A \u043E\u043A\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 292544512
    m_Localized: "\u0427\u0442\u043E \u044D\u0442\u043E \u0437\u0430 \u0444\u043E\u0442\u043E\u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 292544513
    m_Localized: "\xAB\u0428\u043A\u0430\u0442\u0443\u043B\u043A\u0430 \u0420\u0443\u0442. \u042D\u043B\u0438\u0441 \u043D\u0430\u0448\u043B\u0430 \u0435\u0451 \u043D\u0430 \u0447\u0435\u0440\u0434\u0430\u043A\u0435 \u0438 \u043D\u043E\u0441\u0438\u043B\u0430\u0441\u044C \u0441 \u043D\u0435\u0439 \u043A\u0430\u043A \u0441 \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0435\u043C. \u0413\u043E\u0432\u043E\u0440\u0438\u043B\u0430, \u0447\u0442\u043E \u0437\u0430\u043C\u043E\u043A \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F, \u0435\u0441\u043B\u0438 \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u043D\u0438\u043C\u043A\u0438 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u0441\u0442\u0430\u0440\u043E\u0439 \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0438. \u0418 \u0447\u0442\u043E \u043D\u0430 \u0441\u043D\u0438\u043C\u043A\u0430\u0445 \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F \u043B\u0438\u0446\u0430. \u042F \u0434\u0443\u043C\u0430\u043B\u0430, \u043E\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u0441\u0442\u0430\u043B\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 389013504
    m_Localized: "\xAB\u0414\u0430, \u044D\u0442\u043E \u043C\u043E\u044F \u043F\u043E\u0434\u043F\u0438\u0441\u044C. \u042F \u0432\u0437\u044F\u043B\u0430 \u0437\u0430\u0434\u0430\u0442\u043E\u043A \u0438 \u043F\u0440\u0438\u0448\u043B\u0430 \u043A \u042D\u043B\u0438\u0441 \u0432 20:50 \u2014 \u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0435\u0449\u0451 \u043D\u0435\u0434\u0435\u043B\u044E. \u041E\u043D\u0430 \u043D\u0435 \u0434\u0430\u043B\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 389013505
    m_Localized: "\u041C\u0430\u0440\u0430 \u0431\u043B\u0435\u0434\u043D\u0435\u0435\u0442, \u0441\u043B\u0443\u0448\u0430\u044F \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u043A\u0440\u0438\u043A. \xAB\u0414\u0430, \u044F \u043A\u0440\u0438\u0447\u0430\u043B\u0430. \u041F\u043E\u0442\u043E\u043C \u0445\u043B\u043E\u043F\u043D\u0443\u043B\u0430 \u0434\u0432\u0435\u0440\u044C\u044E \u0438 \u0443\u0448\u043B\u0430 \u2014 \u0431\u044B\u043B\u043E \u043F\u043E\u0447\u0442\u0438 \u0434\u0435\u0432\u044F\u0442\u044C. \u0423 \u0432\u043E\u0440\u043E\u0442 \u0441\u0442\u043E\u044F\u043B\u0430 \u0442\u0451\u043C\u043D\u0430\u044F \u043C\u0430\u0448\u0438\u043D\u0430 \u0441 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u043C\u0438 \u043D\u043E\u043C\u0435\u0440\u0430\u043C\u0438, \u043C\u043E\u0442\u043E\u0440 \u0437\u0430\u0433\u043B\u0443\u0448\u0435\u043D. \u042F \u0440\u0435\u0448\u0438\u043B\u0430, \u0447\u0442\u043E \u043A\u0442\u043E-\u0442\u043E \u043F\u0440\u0438\u0435\u0445\u0430\u043B \u043D\u0430 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A \u043F\u043E\u0440\u0430\u043D\u044C\u0448\u0435\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 389013506
    m_Localized: "\xAB\u041C\u0430\u043C\u0438\u043D\u044B \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u043D\u0438\u043A\u0438. \u0418\u0445 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B\u043E \u0434\u0432\u0430, \u0441\u0442\u043E\u044F\u043B\u0438 \u043D\u0430 \u043F\u043E\u043B\u043A\u0435 \u0443 \u042D\u043B\u0438\u0441. \u0412\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0435\u0442? \u041E\u043D \u0436\u0435 \u0442\u044F\u0436\u0451\u043B\u044B\u0439, \u043C\u0435\u0434\u043D\u044B\u0439\u2026\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 389013507
    m_Localized: "\xAB\u042D\u0442\u043E \u0447\u0430\u0441\u044B \u042D\u043B\u0438\u0441. \u041F\u043E\u0434\u0430\u0440\u043E\u043A \u043E\u0442\u0446\u0430. \u041E\u043D\u0430 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u0438\u0445 \u043D\u0435 \u0441\u043D\u0438\u043C\u0430\u043B\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 560979968
    m_Localized: "\u041E\u0443\u044D\u043D \u0411\u043B\u0435\u0439\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 560979969
    m_Localized: "\u0412\u043B\u0430\u0434\u0435\u043B\u0435\u0446 \u0430\u043D\u0442\u0438\u043A\u0432\u0430\u0440\u043D\u043E\u0439 \u043B\u0430\u0432\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 560979970
    m_Localized: "\xAB\u041E\u043D\u0430 \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0430 \u044D\u0442\u043E \u0441\u0432\u043E\u0438\u043C \u0434\u043E\u043C\u043E\u043C. \u0410 \u043C\u043E\u044F \u0431\u0430\u0431\u0443\u0448\u043A\u0430 \u0432\u044B\u0440\u0430\u0441\u0442\u0438\u043B\u0430 \u0442\u0430\u043C \u0434\u0435\u0442\u0435\u0439. \u0422\u0435\u043F\u0435\u0440\u044C \u043C\u0438\u0441\u0441 \u0423\u043E\u0440\u0434 \u043C\u0435\u0440\u0442\u0432\u0430 \u2014 \u0438 \u0432\u044B \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043D\u0430 \u043C\u0435\u043D\u044F \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E \u044D\u0442\u043E \u044F \u0447\u0442\u043E-\u0442\u043E \u0443\u043A\u0440\u0430\u043B\xBB. \u041D\u0430 \u0435\u0433\u043E \u043F\u0430\u043B\u044C\u0446\u0430\u0445 \u043F\u044B\u043B\u044C \u0438 \u0441\u043B\u0435\u0434\u044B \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u043E\u0439 \u043F\u0430\u0441\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 560979971
    m_Localized: "\xAB\u041E\u0431 \u044D\u0442\u043E\u043C \u044F \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0437\u043D\u0430\u044E\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 560979972
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0432\u044B \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0435 \u0434\u043E\u043C \u0441\u0432\u043E\u0438\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 560979973
    m_Localized: "\xAB\u0412\u043E\u0442 \u0437\u0430\u0432\u0435\u0449\u0430\u043D\u0438\u0435. \u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0430 \u0434\u043E\u043C \u043C\u043E\u0438\u043C \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044F\u043C. \u041F\u043E\u0442\u043E\u043C \u0448\u0442\u0430\u0442 \u0432\u0434\u0440\u0443\u0433 \u0441\u0442\u0430\u043B \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0435\u043C. \u0415\u0451 \u0437\u0430\u043F\u0443\u0433\u0430\u043B\u0438 \u0434\u043E\u043B\u0433\u0430\u043C\u0438, \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u0442\u044C \u2014 \u044F \u0443\u0432\u0435\u0440\u0435\u043D. \u042D\u043B\u0438\u0441 \u043D\u0430\u0448\u043B\u0430 \u0441\u0435\u043C\u0435\u0439\u043D\u044B\u0435 \u0431\u0443\u043C\u0430\u0433\u0438 \u0438 \u043D\u0435 \u043E\u0442\u0434\u0430\u0432\u0430\u043B\u0430 \u0438\u0445. \u0410 \u043C\u043E\u044E \u043B\u0430\u0432\u043A\u0443 \u0432\u044B\u0441\u0435\u043B\u044F\u044E\u0442. \u042D\u0442\u043E\u0442 \u0434\u043E\u043C \u043C\u043E\u0433 \u0441\u043F\u0430\u0441\u0442\u0438 \u0432\u0441\u0451\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 560979974
    m_Localized: "\u0412\u044B \u0443\u0433\u0440\u043E\u0436\u0430\u043B\u0438 \u042D\u043B\u0438\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 560979975
    m_Localized: "\xAB\u0421\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u043E\u043D\u0430 \u043F\u043E\u0436\u0430\u043B\u0435\u0435\u0442, \u0435\u0441\u043B\u0438 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B. \u041D\u0435 \u043E \u0441\u043C\u0435\u0440\u0442\u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u043B. \u0412\u0447\u0435\u0440\u0430 \u0443\u0442\u0440\u043E\u043C \u043E\u043D\u0430 \u043F\u043E\u0437\u0432\u043E\u043D\u0438\u043B\u0430: \u043D\u0430\u0448\u043B\u0430 \u0431\u0430\u0431\u0443\u0448\u043A\u0438\u043D\u043E \u043F\u0438\u0441\u044C\u043C\u043E, \u0445\u043E\u0442\u0435\u043B\u0430 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043B\u0438\u0447\u043D\u043E. \u042F \u0440\u0435\u0448\u0438\u043B, \u0447\u0442\u043E \u043E\u043D\u0430 \u0441\u043D\u043E\u0432\u0430 \u0442\u044F\u043D\u0435\u0442 \u0432\u0440\u0435\u043C\u044F. \u0414\u043D\u0451\u043C \u043C\u044B \u043F\u043E\u0441\u0441\u043E\u0440\u0438\u043B\u0438\u0441\u044C, \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u044F \u043A \u043D\u0435\u0439 \u043D\u0435 \u0445\u043E\u0434\u0438\u043B\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 560979976
    m_Localized: "\u0413\u0434\u0435 \u0432\u044B \u0431\u044B\u043B\u0438 \u0432\u0447\u0435\u0440\u0430 \u043E\u043A\u043E\u043B\u043E \u0434\u0435\u0432\u044F\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 560979977
    m_Localized: "\xAB\u0412 \u043B\u0430\u0432\u043A\u0435. \u0417\u0430\u043A\u0440\u044B\u043B\u0441\u044F \u0432 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0441\u043E\u0440\u043E\u043A, \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u043B \u0432\u0435\u0449\u0438 \u0434\u043E \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438 \u043C\u0438\u043D\u0443\u0442 \u0434\u0435\u0441\u044F\u0442\u043E\u0433\u043E. \u041E\u0434\u0438\u043D. \u041A\u0430\u043C\u0435\u0440\u0430 \u0441\u043B\u043E\u043C\u0430\u043D\u0430 \u0443\u0436\u0435 \u043C\u0435\u0441\u044F\u0446. \u0412\u0435\u0440\u0438\u0442\u044C \u0438\u043B\u0438 \u043D\u0435\u0442 \u2014 \u0432\u0430\u0448\u0435 \u0434\u0435\u043B\u043E\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 560979978
    m_Localized: "\u041E\u0442\u043A\u0443\u0434\u0430 \u0432\u0437\u044F\u043B\u0430\u0441\u044C \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0430 \u0420\u0443\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 560979979
    m_Localized: "\xAB\u0420\u0443\u0442 \u0434\u0440\u0443\u0436\u0438\u043B\u0430 \u0441 \u043C\u043E\u0438\u043C \u043E\u0442\u0446\u043E\u043C. \u041E\u043D \u0441\u0434\u0435\u043B\u0430\u043B \u0434\u043B\u044F \u043D\u0435\u0451 \u0437\u0430\u043C\u043E\u043A \u043F\u043E \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0443 \u0438\u0445 \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0438. \u041F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E \u043A\u0430\u043A \u043E\u043D\u0430 \u043F\u0440\u043E\u043F\u0430\u043B\u0430, \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0430 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0443 \u0431\u0430\u0431\u0443\u0448\u043A\u0438, \u0430 \u043F\u043E\u0442\u043E\u043C \u0437\u0430\u0442\u0435\u0440\u044F\u043B\u0430\u0441\u044C \u043D\u0430 \u0447\u0435\u0440\u0434\u0430\u043A\u0435. \u042F \u0431\u044B \u0443\u0437\u043D\u0430\u043B \u0435\u0451 \u0441\u0440\u0435\u0434\u0438 \u0441\u043E\u0442\u043D\u0438 \u0432\u0435\u0449\u0435\u0439. \u041D\u043E \u042D\u043B\u0438\u0441 \u043D\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u043B\u0430 \u043C\u043D\u0435 \u043D\u0438\u0447\u0435\u0433\u043E \u0437\u0430\u0431\u0438\u0440\u0430\u0442\u044C \u0438\u0437 \u0434\u043E\u043C\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 560979980
    m_Localized: "\u041E\u0443\u044D\u043D \u0434\u043E\u043B\u0433\u043E \u0447\u0438\u0442\u0430\u0435\u0442 \u043F\u0438\u0441\u044C\u043C\u043E, \u0448\u0435\u0432\u0435\u043B\u044F \u0433\u0443\u0431\u0430\u043C\u0438. \xAB\u041E\u043D\u0430 \u0441\u0430\u043C\u0430 \u043F\u0440\u043E\u0434\u0430\u043B\u0430 \u0434\u043E\u043C. \u0410 \u044F \u0434\u0432\u0430 \u0433\u043E\u0434\u0430 \u043E\u0431\u0432\u0438\u043D\u044F\u043B \u0432\u0441\u0435\u0445 \u0432\u043E\u043A\u0440\u0443\u0433\xBB. \u041E\u043D \u0431\u0435\u0440\u0435\u0436\u043D\u043E \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043B\u0438\u0441\u0442. \xAB\u041E\u0442\u0435\u0446 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B \u043F\u0440\u043E \u0442\u0443 \u043D\u043E\u0447\u044C, \u043A\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u043F\u0430\u043B\u0430 \u0420\u0443\u0442. \u0418\u0445 \u0431\u044B\u043B\u043E \u0447\u0435\u0442\u0432\u0435\u0440\u043E. \u0412\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u0442\u0440\u043E\u0435. \u041E\u043D \u0442\u0430\u043A \u0438 \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B, \u043A\u0442\u043E \u0431\u044B\u043B \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u043C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 560979981
    m_Localized: "\xAB\u041C\u0435\u0434\u043D\u0430\u044F \u0441\u0442\u0440\u0443\u0436\u043A\u0430? \u0422\u0430\u043A\u0430\u044F \u0431\u044B\u0432\u0430\u0435\u0442 \u043E\u0442 \u043B\u0438\u0442\u043E\u0439 \u043C\u0435\u0434\u0438, \u0435\u0441\u043B\u0438 \u0443\u0434\u0430\u0440\u0438\u0442\u044C \u0443\u0433\u043B\u043E\u043C \u043E\u0431\u043E \u0447\u0442\u043E-\u0442\u043E \u0442\u0432\u0451\u0440\u0434\u043E\u0435. \u042F \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C \u043F\u043E\u043B\u0438\u0440\u0443\u044E \u043B\u0430\u0442\u0443\u043D\u044C \u2014 \u0432\u0438\u0434\u0438\u0442\u0435? \u2014 \u041E\u043D \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043F\u0430\u043B\u044C\u0446\u044B \u0432 \u043F\u0430\u0441\u0442\u0435. \u2014 \u041D\u043E \u043C\u0435\u0434\u044C\u044E \u044F \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435 \u0431\u0438\u043B\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 560979982
    m_Localized: "\xAB\u041F\u0430\u0440\u0430 \u043C\u0435\u0434\u043D\u044B\u0445 \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u043D\u0438\u043A\u043E\u0432 \u0423\u043E\u0440\u0434\u043E\u0432, \u043A\u043E\u043D\u0435\u0446 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E \u0432\u0435\u043A\u0430. \u042F \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u043B \u042D\u043B\u0438\u0441 \u0437\u0430 \u043D\u0438\u0445 \u0442\u0440\u0438\u0441\u0442\u0430 \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432. \u0412\u0442\u043E\u0440\u043E\u0439 \u043F\u0440\u043E\u043F\u0430\u043B? \u041B\u0438\u0442\u0430\u044F \u043C\u0435\u0434\u044C, \u0444\u0443\u043D\u0442\u0430 \u0447\u0435\u0442\u044B\u0440\u0435\u2026 \u0422\u044F\u0436\u0451\u043B\u0430\u044F \u0432\u0435\u0449\u044C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 560979983
    m_Localized: "\xAB\u0412\u044B\u043F\u0438\u0441\u043A\u0430 \u0438\u0437 \u0440\u0435\u0435\u0441\u0442\u0440\u0430? \u0417\u043D\u0430\u0447\u0438\u0442, \u0431\u0430\u0431\u0443\u0448\u043A\u0430 \u043F\u0440\u043E\u0434\u0430\u043B\u0430 \u0434\u043E\u043C \u0441\u0430\u043C\u0430\u2026\xBB \u041E\u0443\u044D\u043D \u0440\u0430\u0441\u0442\u0435\u0440\u044F\u043D\u043D\u043E \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442 \u0440\u0443\u043A\u043E\u0439 \u043F\u043E \u043B\u0438\u0446\u0443. \xAB\u041D\u043E \u043F\u043E\u0447\u0435\u043C\u0443 \u043E\u043D\u0430 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0430\u043C \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0430?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 749723648
    m_Localized: "\u042D\u0434\u0433\u0430\u0440 \u0420\u0438\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 749723649
    m_Localized: "\u041C\u044D\u0440 \u0425\u043E\u043B\u043B\u043E\u0443-\u041A\u0440\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 749723650
    m_Localized: "\xAB\u042F \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B \u0448\u0435\u0440\u0438\u0444\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0432\u0441\u0435 \u0431\u0443\u043C\u0430\u0433\u0438 \u042D\u043B\u0438\u0441. \u0415\u0441\u043B\u0438 \u043A\u0442\u043E-\u0442\u043E \u0437\u043B\u043E\u0443\u043F\u043E\u0442\u0440\u0435\u0431\u0438\u043B \u0435\u0451 \u0434\u043E\u0432\u0435\u0440\u0438\u0435\u043C, \u044D\u0442\u043E \u0434\u043E\u043B\u0436\u043D\u043E \u0432\u044B\u0439\u0442\u0438 \u043D\u0430\u0440\u0443\u0436\u0443. \u0425\u043E\u0442\u0438\u0442\u0435 \u043A\u043E\u0444\u0435? \u0412\u044B \u0441\u043E\u0432\u0441\u0435\u043C \u0437\u0430\u043C\u0451\u0440\u0437\u043B\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 749723651
    m_Localized: "\xAB\u0411\u043E\u044E\u0441\u044C, \u043D\u0438\u0447\u0435\u043C \u043D\u0435 \u043C\u043E\u0433\u0443 \u043F\u043E\u043C\u043E\u0447\u044C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 749723652
    m_Localized: "\u0413\u0434\u0435 \u0432\u044B \u0431\u044B\u043B\u0438 \u0432\u0447\u0435\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 749723653
    m_Localized: "\xAB\u0412 21:05 \u043F\u043E\u043A\u0443\u043F\u0430\u043B \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E \u0432 \u043A\u0440\u0443\u0433\u043B\u043E\u0441\u0443\u0442\u043E\u0447\u043D\u043E\u0439 \u0430\u043F\u0442\u0435\u043A\u0435 \u043D\u0430 \u041C\u0435\u0439\u043F\u043B-\u0441\u0442\u0440\u0438\u0442. \u0412\u0440\u0435\u043C\u044F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435 \u2014 \u0436\u0435\u043D\u0430 \u043A\u0430\u043A \u0440\u0430\u0437 \u043D\u0430\u043F\u0438\u0441\u0430\u043B\u0430. \u0417\u0430\u0448\u0451\u043B \u0432\u043D\u0443\u0442\u0440\u044C, \u0432\u0437\u044F\u043B \u0443 \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0430, \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0438\u043B\u0441\u044F \u043D\u0430\u043B\u0438\u0447\u043D\u044B\u043C\u0438. \u0427\u0435\u043A? \u0412\u044B\u0431\u0440\u043E\u0441\u0438\u043B. \u041F\u043E\u0442\u043E\u043C \u043F\u043E\u0435\u0445\u0430\u043B \u0434\u043E\u043C\u043E\u0439. \u041A \u042D\u043B\u0438\u0441 \u044F \u043D\u0435 \u0437\u0430\u0445\u043E\u0434\u0438\u043B\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 749723654
    m_Localized: "\u0427\u0442\u043E \u0432\u0430\u0441 \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u043B\u043E \u0441 \u042D\u043B\u0438\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 749723655
    m_Localized: "\xAB\u041E\u043D\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u043B\u0430 \u043F\u0440\u043E\u0434\u0430\u0436\u0443 \u0443\u0447\u0430\u0441\u0442\u043A\u043E\u0432 \u0443 \u0440\u0443\u0447\u044C\u044F. \u042F \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u044E \u043C\u043D\u043E\u0433\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432 \u0438 \u043E\u0431\u0435\u0449\u0430\u043B \u0435\u0439 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F. \u0421\u043B\u044B\u0448\u0430\u043B, \u0443 \u043D\u0435\u0451 \u0431\u044B\u043B\u0438 \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0438 \u0441 \u043F\u0440\u043E\u0434\u0430\u0436\u0435\u0439 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0434\u043E\u043C\u0430. \u041D\u0435 \u0445\u043E\u0447\u0443 \u0441\u0443\u0434\u0438\u0442\u044C \u043E \u0447\u0443\u0436\u043E\u0439 \u0441\u0435\u043C\u044C\u0435\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 749723656
    m_Localized: "\u0412\u044B \u0437\u043D\u0430\u043B\u0438 \u043E \u0431\u0443\u043C\u0430\u0433\u0430\u0445 \u0432 \u0441\u0435\u0439\u0444\u0435 \u042D\u043B\u0438\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 749723657
    m_Localized: "\xAB\u042D\u043B\u0438\u0441 \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0430 \u0432\u0441\u044F\u043A\u043E\u0435. \u0421\u043B\u0443\u0445\u0438, \u0441\u043F\u043B\u0435\u0442\u043D\u0438, \u0447\u0443\u0436\u0438\u0435 \u043E\u0431\u0438\u0434\u044B. \u0423\u0432\u0435\u0440\u0435\u043D, \u0448\u0435\u0440\u0438\u0444 \u0432\u043E \u0432\u0441\u0451\u043C \u0440\u0430\u0437\u0431\u0435\u0440\u0451\u0442\u0441\u044F\xBB. \u041E\u043D \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F, \u043D\u043E \u043D\u0430 \u0432\u0438\u0441\u043A\u0435 \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u043A\u0430\u043F\u043B\u044F \u043F\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 749723658
    m_Localized: "\u0420\u0438\u0434 \u043D\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u0437\u0430\u043C\u0438\u0440\u0430\u0435\u0442. \xAB\u0417\u043D\u0430\u0447\u0438\u0442, \u044F \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u0430\u043B\u2026 \u0414\u0430, \u0441\u0432\u0435\u0442 \u043F\u043E\u0433\u0430\u0441. \u042F \u0441\u0438\u0434\u0435\u043B \u0432 \u043C\u0430\u0448\u0438\u043D\u0435 \u0443 \u0430\u043F\u0442\u0435\u043A\u0438, \u0436\u0434\u0430\u043B, \u043A\u043E\u0433\u0434\u0430 \u043E\u0442\u043A\u0440\u043E\u044E\u0442. \u041D\u0438\u043A\u0442\u043E \u044D\u0442\u043E\u0433\u043E \u043D\u0435 \u0432\u0438\u0434\u0435\u043B, \u043A\u043E\u043D\u0435\u0447\u043D\u043E\xBB. \u041C\u0438\u043D\u0443\u0442\u0443 \u043D\u0430\u0437\u0430\u0434 \u043E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0447\u0442\u043E \u043F\u043E\u043A\u0443\u043F\u0430\u043B \u0443 \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 749723659
    m_Localized: "\xAB\u041E\u0442\u043A\u043B\u044E\u0447\u0430\u043B\u0438 \u0441\u0432\u0435\u0442? \u041D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B. \u0410\u043F\u0442\u0435\u043A\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430, \u044F \u0436\u0435 \u0442\u0430\u043C \u0431\u044B\u043B\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 749723660
    m_Localized: "\xAB\u041F\u043E\u0434\u0434\u0435\u043B\u043A\u0430! \u2014 \u0420\u0438\u0434 \u0440\u0435\u0437\u043A\u043E \u043E\u0442\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0447\u0430\u0448\u043A\u0443. \u2014 \u042D\u043B\u0438\u0441 \u0445\u043E\u0442\u0435\u043B\u0430 \u043C\u0435\u043D\u044F \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C. \u0416\u0443\u0440\u043D\u0430\u043B\u0438\u0441\u0442\u044B \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0430\u0445\u043E\u0434\u044F\u0442 \u0442\u0443 \u043F\u043E\u0434\u043F\u0438\u0441\u044C, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0445\u043E\u0442\u044F\u0442 \u043D\u0430\u0439\u0442\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 749723661
    m_Localized: "\u0420\u0438\u0434 \u0431\u043B\u0435\u0434\u043D\u0435\u0435\u0442 \u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F. \xAB\u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u043E\u043A\u043E\u043D\u0447\u0435\u043D. \u0412\u0441\u0435 \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u2014 \u0447\u0435\u0440\u0435\u0437 \u043C\u043E\u0435\u0433\u043E \u0430\u0434\u0432\u043E\u043A\u0430\u0442\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 749723662
    m_Localized: "\xAB\u0422\u0451\u043C\u043D\u044B\u0445 \u043C\u0430\u0448\u0438\u043D \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u043C\u043D\u043E\u0433\u043E, \u043C\u0438\u0441\u0441 \u0425\u0435\u0439\u043B\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 2003232088064
    m_Localized: "\u041C\u0430\u0440\u0430 \u0443\u0441\u0442\u0430\u043B\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0433\u043B\u0430\u0437\u0430: \xAB\u0415\u0449\u0451 \u0432\u043E\u043F\u0440\u043E\u0441\u044B?\xBB"
