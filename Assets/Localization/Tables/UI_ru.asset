  - m_Id: 6895984173056
    m_Localized: "\u041F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0442\u044C \u0443\u043B\u0438\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6896072253440
    m_Localized: "\u0423\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6896072253441
    m_Localized: "\u041A\u0430\u043A\u0443\u044E \u0443\u043B\u0438\u043A\u0443 \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 6896072253442
    m_Localized: "\u041F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6896072253443
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 11366885744640
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 11366957047808
    m_Localized: "\u0421\u0442\u0435\u0440\u0435\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 11366957047809
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 11366957047810
    m_Localized: "\u041D\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u043A\u043E\u0434: \u043A\u043D\u043E\u043F\u043A\u0438 \u0438\u043B\u0438 \u0446\u0438\u0444\u0440\u044B \u043D\u0430 \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 11366957047811
    m_Localized: "\u041D\u0435\u0432\u0435\u0440\u043D\u0430\u044F \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 11366957047812
    m_Localized: "\u041A\u043E\u0434 \u043F\u0440\u0438\u043D\u044F\u0442. \u0417\u0430\u043C\u043E\u043A \u0449\u0451\u043B\u043A\u0430\u0435\u0442\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 11366957047813
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 11366957047814
    m_Localized: "\u0429\u0451\u043B\u043A\u043D\u0438\u0442\u0435 \u043F\u043E \u0441\u043D\u0438\u043C\u043A\u0443, \u0437\u0430\u0442\u0435\u043C \u043F\u043E \u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u2014 \u043E\u043D\u0438 \u043F\u043E\u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F \u043C\u0435\u0441\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 11366957047815
    m_Localized: "\u0417\u0430\u0436\u043C\u0438\u0442\u0435 \u041B\u041A\u041C \u0438 \u0432\u043E\u0434\u0438\u0442\u0435 \u043F\u043E \u0441\u0442\u0440\u043E\u043A\u0430\u043C (\u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u0438 + \u043F\u0440\u043E\u0431\u0435\u043B)."
    m_Metadata:
      m_Items: []
  - m_Id: 11366978019328
    m_Localized: "\u041B\u0435\u0432\u044B\u0439 \u0441\u0442\u0438\u043A \u2014 \u0432\u0435\u0441\u0442\u0438 \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448, A \u2014 \u0448\u0442\u0440\u0438\u0445\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 14988436561920
    m_Localized: "\u0412\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 14988528836608
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u043D\u0430 \u0443\u043B\u0438\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 14988528836609
    m_Localized: "\u0420\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 14988528836610
    m_Localized: "\u0412\u044B\u043D\u0443\u0442\u044C \u044F\u0449\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 14988528836611
    m_Localized: "\u041F\u043E\u0441\u0432\u0435\u0442\u0438\u0442\u044C \u043F\u043E\u0434 \u0441\u0442\u043E\u043B\u0435\u0448\u043D\u0438\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 18749619953664
    m_Localized: "\u0426\u0415\u041B\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 18749712228352
    m_Localized: "\u0426\u0415\u041B\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 18749712228353
    m_Localized: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 18749712228354
    m_Localized: "\u041D\u0430\u0437\u0432\u0430\u0442\u044C \u0443\u0431\u0438\u0439\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 18749712228355
    m_Localized: "\u0420\u0430\u0437\u0432\u044F\u0437\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 18749712228356
    m_Localized: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 18749712228357
    m_Localized: "\u0415\u0449\u0451 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 18749712228358
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043E\u0442\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 18749712228359
    m_Localized: "\u0422\u043E\u0447\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043E\u0442\u0432\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 18749712228360
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u043D\u0435\u0447\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 18749712228361
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 18749712228362
    m_Localized: "\u041A\u0442\u043E \u0443\u0431\u0438\u043B \u042D\u043B\u0438\u0441 \u0423\u043E\u0440\u0434?"
    m_Metadata:
      m_Items: []
  - m_Id: 18749712228363
    m_Localized: "\u041D\u0430\u0437\u043E\u0432\u0438\u0442\u0435 \u0448\u0435\u0440\u0438\u0444\u0443 \u0443\u0431\u0438\u0439\u0446\u0443, \u0435\u0433\u043E \u043C\u043E\u0442\u0438\u0432 \u0438 \u0443\u043B\u0438\u043A\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0440\u0430\u0437\u043E\u0431\u043B\u0430\u0447\u0430\u0435\u0442 \u0435\u0433\u043E \u043B\u043E\u0436\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 18749712228364
    m_Localized: "\u041F\u041E\u0414\u041E\u0417\u0420\u0415\u0412\u0410\u0415\u041C\u042B\u0419"
    m_Metadata:
      m_Items: []
  - m_Id: 18749716422656
    m_Localized: "\u041C\u041E\u0422\u0418\u0412"
    m_Metadata:
      m_Items: []
  - m_Id: 18749716422657
    m_Localized: "\u041B\u041E\u0416\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 18749716422658
    m_Localized: "\u0412\u044B\u0431\u0440\u0430\u0442\u044C \u0443\u043B\u0438\u043A\u0443\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 18749716422659
    m_Localized: "\u041F\u043E\u0437\u0432\u043E\u043D\u0438\u0442\u044C \u0448\u0435\u0440\u0438\u0444\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 18749716422660
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 18749716422661
    m_Localized: "\u0427\u0442\u043E \u0431\u044B\u043B\u043E \u043C\u043E\u0442\u0438\u0432\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 18749716422662
    m_Localized: "\u041A\u0430\u043A\u0430\u044F \u0443\u043B\u0438\u043A\u0430 \u0440\u0430\u0437\u043E\u0431\u043B\u0430\u0447\u0430\u0435\u0442 \u043B\u043E\u0436\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 18749716422663
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u043E\u0433\u043E, \u043C\u043E\u0442\u0438\u0432 \u0438 \u043B\u043E\u0436\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 20219840946176
    m_Localized: "\u0412\u044B\u0431\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 64921978003456
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 64922061889536
    m_Localized: "\u0425\u043E\u043B\u043B\u043E\u0443-\u041A\u0440\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 64922061889537
    m_Localized: "\u041D\u043E\u0447\u044C \u043C\u0430\u0441\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 64922061889538
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 64922061889539
    m_Localized: "\u041D\u043E\u0432\u0430\u044F \u0438\u0433\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 64922061889540
    m_Localized: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 64922061889541
    m_Localized: "\u041E\u0431 \u0438\u0433\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 64922061889542
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u0438\u0437 \u0438\u0433\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 64922061889543
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0437\u0430\u043D\u043E\u0432\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 64922061889544
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u0439 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u0442\u0435\u0440\u044F\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 64922061889545
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0437\u0430\u043D\u043E\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 64922061889546
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C \u0438\u0433\u0440\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 64922061889547
    m_Localized: "\u041F\u0430\u0443\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 64922061889548
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u0438\u0433\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 64922066083840
    m_Localized: "\u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u043C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 64922066083841
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u0432 \u0433\u043B\u0430\u0432\u043D\u043E\u0435 \u043C\u0435\u043D\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 64922066083842
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u0438\u0437 \u0438\u0433\u0440\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 64922066083843
