      m_Items: []
  - m_Id: 749723660
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 749723661
    m_Localized: "\u041D\u043E\u0432\u0430\u044F \u0443\u043B\u0438\u043A\u0430: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 749723662
    m_Localized: "\u041D\u043E\u0432\u044B\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 749723663
    m_Localized: "\u0417\u0430\u0436\u043C\u0438\u0442\u0435 \u041B\u041A\u041C \u0438 \u0432\u0435\u0434\u0438\u0442\u0435 \u043C\u044B\u0448\u044C\u044E \u2014 \u0432\u0440\u0430\u0449\u0430\u0442\u044C  \xB7  \u041A\u043E\u043B\u0435\u0441\u043E \u2014 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u044C  \xB7  Esc \u2014 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 749723664
    m_Localized: "\u041F\u0440\u0430\u0432\u044B\u0439 \u0441\u0442\u0438\u043A \u2014 \u0432\u0440\u0430\u0449\u0430\u0442\u044C  \xB7  \u041A\u0443\u0440\u043A\u0438 \u2014 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u044C  \xB7  B \u2014 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
