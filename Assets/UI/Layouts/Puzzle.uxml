<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="puzzle" class="layer dim hidden">
        <ui:VisualElement class="panel puzzle__panel">
            <ui:VisualElement class="notebook__header">
                <ui:Label name="puzzle-title" class="title" />
                <ui:Button name="puzzle-close" text="@puzzle.close" class="button" />
            </ui:VisualElement>
            <ui:Label name="puzzle-instructions" class="body-text puzzle__instructions" />
            <ui:VisualElement name="puzzle-body" class="puzzle__body" />
            <ui:Label name="puzzle-status" class="puzzle__status" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
