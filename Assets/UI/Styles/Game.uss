/* Общие цвета и шрифты игры. Переменные используются во всех экранах. */
:root {
    --color-ink: rgb(10, 15, 19);
    --color-panel: rgba(16, 23, 27, 0.96);
    --color-panel-light: rgb(30, 40, 44);
    --color-line: rgba(214, 204, 173, 0.18);
    --color-cream: rgb(214, 204, 173);
    --color-muted: rgb(150, 144, 126);
    --color-amber: rgb(235, 166, 82);
    --color-rust: rgb(191, 94, 33);
    --font-body: url("project://database/Assets/UI/Fonts/PTSans-Regular.ttf");
    --font-bold: url("project://database/Assets/UI/Fonts/PTSans-Bold.ttf");
    --font-title: url("project://database/Assets/UI/Fonts/PTSerif-Bold.ttf");

    -unity-font-definition: var(--font-body);
    color: var(--color-cream);
    font-size: 20px;
}

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hidden {
    display: none;
}

/* ---------- Общие элементы ---------- */

.title {
    -unity-font-definition: var(--font-title);
    font-size: 34px;
    color: var(--color-amber);
    white-space: normal;
}

.subtitle {
    font-size: 16px;
    color: var(--color-muted);
    letter-spacing: 1px;
    white-space: normal;
}

.body-text {
    font-size: 21px;
    white-space: normal;
    margin-top: 12px;
}

.section-header {
    -unity-font-definition: var(--font-bold);
    font-size: 15px;
    letter-spacing: 2px;
    color: var(--color-amber);
    margin-top: 18px;
    margin-bottom: 6px;
}

.button {
    -unity-font-definition: var(--font-bold);
    font-size: 19px;
    color: var(--color-cream);
    background-color: var(--color-panel-light);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: 3px;
    padding: 10px 22px;
    margin: 0;
    transition-duration: 0.12s;
}

.button:hover {
    border-color: var(--color-amber);
    color: var(--color-amber);
}

.button:active {
    background-color: rgb(44, 56, 60);
}

.dim {
    background-color: rgba(4, 7, 9, 0.72);
    align-items: center;
    justify-content: center;
}

.panel {
    background-color: var(--color-panel);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: 4px;
    padding: 32px 40px;
}

/* ---------- HUD ---------- */

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6px;
    height: 6px;
    translate: -50% -50%;
    border-radius: 3px;
    background-color: rgba(214, 204, 173, 0.55);
    transition-property: width, height, background-color;
    transition-duration: 0.12s;
}

.crosshair--active {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: var(--color-amber);
}

.prompt {
    position: absolute;
    left: 0;
    right: 0;
    top: 53%;
    -unity-text-align: upper-center;
    -unity-font-definition: var(--font-bold);
    font-size: 20px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.toasts {
    position: absolute;
    right: 32px;
    top: 28px;
    align-items: flex-end;
}

.toast {
    background-color: var(--color-panel);
    border-left-width: 3px;
    border-left-color: var(--color-amber);
    padding: 10px 18px;
    margin-bottom: 8px;
    font-size: 19px;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.35s;
}

.toast--hidden {
    opacity: 0;
    translate: 40px 0;
}

/* ---------- Осмотр ---------- */

.inspection {
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 36px;
}

.inspection__panel {
    width: 62%;
    max-width: 980px;
    padding: 22px 30px;
}

.inspection__hint {
    margin-top: 14px;
    font-size: 15px;
    color: var(--color-muted);
}

/* ---------- Сообщение ---------- */

.message__panel {
    width: 60%;
    max-width: 900px;
    max-height: 80%;
}

.message__body {
    flex-shrink: 1;
}

.message__footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 24px;
}

/* ---------- Дневник ---------- */

.notebook__panel {
    width: 82%;
    height: 82%;
    max-width: 1500px;
}

.notebook__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-line);
    padding-bottom: 14px;
}

.notebook__columns {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 16px;
}

.notebook__list {
    width: 36%;
    border-right-width: 1px;
    border-right-color: var(--color-line);
    padding-right: 16px;
}

.notebook__detail {
    flex-grow: 1;
    padding-left: 32px;
}

.notebook__entry {
    -unity-text-align: middle-left;
    font-size: 19px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    padding: 8px 12px;
    margin: 0 0 2px 0;
    color: var(--color-cream);
    white-space: normal;
}

.notebook__entry:hover {
    background-color: var(--color-panel-light);
}

.notebook__entry--selected {
    border-left-color: var(--color-amber);
    background-color: var(--color-panel-light);
    color: var(--color-amber);
}

.notebook__empty {
    color: var(--color-muted);
    font-size: 18px;
    margin-top: 6px;
    white-space: normal;
}

.button--primary {
    border-color: var(--color-amber);
    color: var(--color-amber);
    margin-left: 12px;
}

/* ---------- Разговор ---------- */

.dialogue {
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 28px;
}

.dialogue__panel {
    width: 72%;
    max-width: 1250px;
    max-height: 62%;
    padding: 24px 34px;
}

.dialogue__header {
    flex-direction: row;
    align-items: flex-end;
}

.dialogue__name {
    font-size: 30px;
    margin-right: 16px;
}

.dialogue__role {
    margin-bottom: 5px;
}

.dialogue__speech-scroll {
    flex-shrink: 1;
    max-height: 240px;
}

.dialogue__speech {
    font-size: 22px;
    margin-bottom: 14px;
}

.dialogue__choices {
    border-top-width: 1px;
    border-top-color: var(--color-line);
    padding-top: 12px;
}

.dialogue__choice {
    -unity-text-align: middle-left;
    -unity-font-definition: var(--font-body);
    white-space: normal;
    margin-bottom: 6px;
    border-left-width: 3px;
    border-left-color: var(--color-amber);
}

.dialogue__choice--asked {
    color: var(--color-muted);
    border-left-color: var(--color-line);
}

.dialogue__footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
}

.dialogue__footer .button {
    margin-left: 12px;
}

/* ---------- Головоломки ---------- */

.puzzle__panel {
    width: 70%;
    max-width: 1150px;
    align-items: stretch;
}

.puzzle__instructions {
    margin-top: 10px;
    color: var(--color-muted);
}

.puzzle__body {
    margin-top: 22px;
    align-items: center;
}

.puzzle__status {
    margin-top: 18px;
    min-height: 26px;
    -unity-text-align: middle-center;
    color: var(--color-amber);
    font-size: 19px;
    white-space: normal;
}

/* Кодовый замок */

.codelock {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.codelock__face {
    width: 300px;
    height: 330px;
    margin-right: 40px;
    align-items: center;
    justify-content: center;
    background-color: rgb(38, 50, 52);
    border-width: 6px;
    border-color: rgb(120, 126, 108);
    border-radius: 10px;
}

.codelock__lamp {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    margin-bottom: 30px;
    background-color: rgb(110, 36, 22);
    transition-property: background-color;
    transition-duration: 0.25s;
}

.codelock__lamp--wrong {
    background-color: rgb(235, 52, 34);
}

.codelock__lamp--right {
    background-color: rgb(60, 230, 110);
}

.codelock__display {
    -unity-font-definition: var(--font-bold);
    font-size: 44px;
    letter-spacing: 6px;
    color: rgb(205, 230, 190);
    background-color: rgb(14, 20, 18);
    padding: 10px 22px;
    border-radius: 4px;
}

.codelock__pad {
    flex-direction: row;
    flex-wrap: wrap;
    width: 330px;
}

.codelock__key {
    width: 98px;
    height: 72px;
    margin: 0 10px 10px 0;
    font-size: 26px;
    padding: 0;
}

.codelock__key--word {
    font-size: 17px;
}

.codelock__key.button--primary {
    margin-left: 0;
}

/* Раскладка снимков */

.sequence {
    align-items: center;
}

.sequence__row {
    flex-direction: row;
    justify-content: center;
}

.photo {
    width: 200px;
    height: 238px;
    margin: 0 10px;
    padding: 12px 12px 42px 12px;
    background-color: rgb(238, 230, 210);
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 2px;
    rotate: -1deg;
    transition-property: translate, border-color;
    transition-duration: 0.15s;
}

.photo:hover,
.photo:focus {
    border-color: rgba(235, 166, 82, 0.5);
}

.photo--selected {
    translate: 0 -18px;
    border-color: var(--color-amber);
}

.photo__image {
    flex-grow: 1;
    background-color: rgb(60, 66, 70);
    -unity-background-scale-mode: scale-and-crop;
}

.sequence__check {
    margin-top: 30px;
}

/* Штриховка */

.rubbing__paper {
    background-color: rgb(222, 208, 176);
    border-width: 1px;
    border-color: rgb(120, 98, 70);
    border-radius: 2px;
    overflow: hidden;
}

.rubbing__line {
    position: absolute;
    height: 36px;
    -unity-text-align: middle-left;
    -unity-font-definition: var(--font-body);
    font-size: 25px;
    color: rgb(62, 55, 50);
    white-space: nowrap;
}

.rubbing__cursor {
    position: absolute;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgb(60, 50, 40);
}

/* ---------- Смена локации ---------- */

.fader {
    background-color: rgb(0, 0, 0);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.fader--clear {
    opacity: 0;
}

.location-title {
    position: absolute;
    left: 0;
    right: 0;
    top: 16%;
    -unity-text-align: middle-center;
    -unity-font-definition: var(--font-title);
    font-size: 46px;
    color: var(--color-cream);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.8s;
}

.location-title--visible {
    opacity: 1;
}

/* ---------- Цели, подсказки, обвинение ---------- */

.objective {
    position: absolute;
    left: 32px;
    top: 28px;
    max-width: 520px;
    padding: 10px 16px;
    background-color: rgba(16, 23, 27, 0.72);
    border-left-width: 3px;
    border-left-color: var(--color-line);
    transition-property: opacity, border-left-color, background-color;
    transition-duration: 0.4s;
}

.objective--new {
    border-left-color: var(--color-amber);
    background-color: rgba(60, 44, 20, 0.85);
}

.objective--dimmed {
    opacity: 0;
}

.objective__header {
    -unity-font-definition: var(--font-bold);
    font-size: 13px;
    letter-spacing: 2px;
    color: var(--color-amber);
}

.objective__text {
    font-size: 19px;
    white-space: normal;
}

.notebook__actions {
    flex-direction: row;
}

.notebook__actions .button {
    margin-left: 10px;
}

.notebook__objectives {
    padding: 4px 0 10px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-line);
}

.notebook__objective {
    font-size: 18px;
    color: var(--color-muted);
    white-space: normal;
}

.notebook__objective--current {
    color: var(--color-cream);
}

.hint__objective {
    margin-top: 4px;
    margin-bottom: 8px;
}

.hint__line {
    border-left-width: 3px;
    border-left-color: var(--color-amber);
    padding-left: 12px;
}

.accusation__panel {
    width: 60%;
    max-width: 900px;
}

.accusation__suspects {
    flex-direction: row;
}

.accusation__suspect {
    margin-right: 12px;
}

.accusation__suspect--selected {
    border-color: var(--color-amber);
    color: var(--color-amber);
    background-color: rgb(60, 44, 20);
}

.accusation__slot {
    -unity-text-align: middle-left;
    white-space: normal;
}
