# Папки, которые Unity генерирует сама (кэш, логи, сборки)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Файлы, которые генерирует IDE (Visual Studio / Rider / VS Code)
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
ExportedObj/
.consulo/

# Мусорные .meta для игнорируемых файлов
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Отчёты о падениях
sysinfo.txt
mono_crash.*

# Собранные билды
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Автоматически сгенерированные ассеты
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Системные файлы ОС
.DS_Store
Thumbs.db
Desktop.ini

# Результаты сборки Addressables
/[Ss]erver[Dd]ata/
